---
// Prairie au vent : herbes et fleurs procédurales, lavande et rose sur fond nuit.
// Elles ondulent au vent et se couchent au passage du curseur (ressort amorti). Quelques lucioles.
import HeroShell from './HeroShell.astro';
---
<HeroShell name="meadow" scrim={false}><slot /></HeroShell>

<script>
  import { runHero, rgba, LAV, PINK } from '../../hero';

  // ───────── CONFIG ─────────
  const DENSITY = 0.3;           // brins par px de largeur
  const PUSH_RADIUS = 95;        // px
  const STIFF = 34, DAMP = 6.5;  // ressort des brins
  const LAYERS = [               // du fond vers l'avant
    { base: [22, 20, 34], tip: [52, 46, 84], hMin: 0.12, hMax: 0.26, wid: 2.2 },
    { base: [26, 23, 40], tip: [84, 72, 132], hMin: 0.16, hMax: 0.34, wid: 2.8 },
    { base: [30, 26, 46], tip: [132, 112, 196], hMin: 0.2, hMax: 0.42, wid: 3.4 },
  ];
  const FLOWERS = [PINK, LAV, [255, 236, 246], [255, 196, 222]];

  document.querySelectorAll<HTMLElement>('[data-hero="meadow"]').forEach((root) => {
    type Blade = { x: number; h: number; w: number; layer: number; bend: number; vel: number; flower: number; fr: number; ph: number };
    type Fly = { x: number; y: number; vx: number; vy: number; ph: number };
    let blades: Blade[] = [];
    let flies: Fly[] = [];

    runHero(root, {
      init(c) {
        const n = Math.round(c.w * DENSITY * (c.w < 700 ? 0.8 : 1));
        blades = [];
        LAYERS.forEach((L, layer) => {
          const count = Math.round(n * [0.9, 0.7, 0.5][layer]);
          for (let i = 0; i < count; i++) {
            blades.push({
              x: Math.random() * (c.w + 40) - 20, layer,
              h: c.h * (L.hMin + Math.random() * (L.hMax - L.hMin)),
              w: L.wid * (0.7 + Math.random() * 0.6),
              bend: 0, vel: 0, ph: Math.random() * 6.28,
              flower: layer > 0 && Math.random() < 0.08 ? (Math.random() * FLOWERS.length) | 0 : -1,
              fr: 2.5 + Math.random() * 2.5,
            });
          }
        });
        flies = Array.from({ length: c.w < 700 ? 12 : 26 }, () => ({
          x: Math.random() * c.w, y: c.h * (0.35 + Math.random() * 0.55),
          vx: (Math.random() - 0.5) * 20, vy: (Math.random() - 0.5) * 12, ph: Math.random() * 6.28,
        }));
      },
      frame(c, t, dt) {
        const { ctx, w, h, ptr } = c;
        ctx.clearRect(0, 0, w, h);
        const y0 = h + 6;

        // lucioles derrière l'herbe avant
        ctx.globalCompositeOperation = 'lighter';
        for (const f of flies) {
          f.vx += (Math.sin(t * 0.7 + f.ph) * 14 - f.vx) * dt; f.vy += (Math.cos(t * 0.5 + f.ph * 2) * 9 - f.vy) * dt;
          f.x += f.vx * dt; f.y += f.vy * dt;
          if (f.x < -10) f.x = w + 10; else if (f.x > w + 10) f.x = -10;
          f.y = Math.min(h * 0.95, Math.max(h * 0.3, f.y));
          const a = 0.35 + 0.35 * Math.sin(t * 2.2 + f.ph * 3);
          const g = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, 9);
          g.addColorStop(0, `rgba(255,240,250,${a})`); g.addColorStop(0.3, rgba(PINK, a * 0.5)); g.addColorStop(1, rgba(PINK, 0));
          ctx.fillStyle = g; ctx.fillRect(f.x - 9, f.y - 9, 18, 18);
        }
        ctx.globalCompositeOperation = 'source-over';

        const layerPaths = LAYERS.map(() => new Path2D());
        const flowerPaths = FLOWERS.map(() => new Path2D());
        for (const b of blades) {
          const wind = 0.13 * Math.sin(t * 0.9 + b.x * 0.006) + 0.05 * Math.sin(t * 2.3 + b.x * 0.021 + b.ph);
          let target = wind;
          if (ptr.active) {
            const dx = b.x - ptr.x;
            const tipY = y0 - b.h;
            if (ptr.y > tipY - 30) {
              const f = Math.exp(-(dx * dx) / (PUSH_RADIUS * PUSH_RADIUS));
              target += Math.sign(dx || 1) * f * 0.95 + ptr.vx * 0.00045 * f;
            }
          }
          target = Math.max(-1.3, Math.min(1.3, target));
          if (c.reduced) b.bend = target;
          else { b.vel += ((target - b.bend) * STIFF - b.vel * DAMP) * dt; b.bend += b.vel * dt; }

          const s = Math.sin(b.bend), co = Math.cos(b.bend);
          const tx = b.x + s * b.h, ty = y0 - co * b.h * (0.92 + 0.08 * co);
          const cx = b.x + Math.sin(b.bend * 0.45) * b.h * 0.5, cy = y0 - b.h * 0.55;
          const p = layerPaths[b.layer];
          p.moveTo(b.x - b.w / 2, y0);
          p.quadraticCurveTo(cx - b.w * 0.3, cy, tx, ty);
          p.quadraticCurveTo(cx + b.w * 0.3, cy, b.x + b.w / 2, y0);
          p.closePath();
          if (b.flower >= 0) { const fp = flowerPaths[b.flower]; fp.moveTo(tx + b.fr, ty); fp.arc(tx, ty, b.fr, 0, Math.PI * 2); }
          // les fleurs de la couche du fond sont dessinées avant la couche suivante
        }
        LAYERS.forEach((L, i) => {
          const g = ctx.createLinearGradient(0, y0, 0, y0 - h * L.hMax);
          g.addColorStop(0, rgba(L.base, 1)); g.addColorStop(1, rgba(L.tip, 1));
          ctx.fillStyle = g; ctx.fill(layerPaths[i]);
        });
        FLOWERS.forEach((col, i) => { ctx.fillStyle = rgba(col, 0.95); ctx.fill(flowerPaths[i]); });
      },
    });
  });
</script>

---
// Nom en particules : une devise latine sur deux lignes (ou "FERDINAND LACROIX") composée de milliers de particules (WebGL2, mélange additif).
// Les points sont échantillonnés sur le texte rendu hors écran, puis tenus par des ressorts amortis.
// La souris les repousse et les fait tourbillonner, un clic les fait exploser, puis le nom se reconstruit.
// Même univers que "Concept" : Unbounded 900, dégradé violet -> bleu, touche de cyan / vert d'eau, HUD discret.
import HeroShell from './HeroShell.astro';
// textes proposés, le premier est affiché à l'arrivée ; fr / en = traduction affichée en info-bulle
const PHRASES = [
  { lines: ['SELECTIO', 'NATURALIS'], fr: 'Sélection naturelle', en: 'Natural selection' },
  { lines: ['PER ASPERA', 'AD ASTRA'], fr: 'Par des sentiers ardus jusqu’aux étoiles', en: 'Through hardships to the stars' },
  { lines: ['ALEA', 'IACTA EST'], fr: 'Le sort en est jeté', en: 'The die is cast' },
  { lines: ['CARPE', 'DIEM'], fr: 'Cueille le jour', en: 'Seize the day' },
  { lines: ['FIAT', 'LUX'], fr: 'Que la lumière soit', en: 'Let there be light' },
  { lines: ['FERDINAND', 'LACROIX'], fr: 'Mon nom', en: 'My name' },
];
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@900&display=swap" />

<HeroShell name="kinetic" scrim={false}>
  <div class="hud" aria-hidden="true">
    <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
    <span class="lbl l-tl">KINETIC / 002<br /><span data-l="fr">TYPO.PARTICULES</span><span data-l="en">TYPE.PARTICLES</span></span>
    <span class="lbl l-tr"><span data-x>X 0.500</span>&nbsp;&nbsp;<span data-y>Y 0.500</span></span>
    <span class="lbl l-bl"><span data-n>00 000</span> <span data-l="fr">PARTICULES</span><span data-l="en">PARTICLES</span> · <span data-l="fr">LIBRES</span><span data-l="en">FREE</span> <span data-free>0</span></span>
    <span class="lbl l-br" data-tc>00:00:00:00</span>
    <span class="lbl sub" data-sub><span class="ms"><span data-l="fr">survolez · cliquez · regardez revenir</span><span data-l="en">hover · click · watch it return</span></span><span class="tch"><span data-l="fr">glissez · touchez · regardez revenir</span><span data-l="en">swipe · tap · watch it return</span></span></span>
  </div>
  <div class="phrases" role="group" aria-label="Texte">
    {PHRASES.map((p, i) => (
      <button type="button" class:list={['ph', { on: i === 0 }]} data-phrase={p.lines.join('|')} aria-pressed={i === 0 ? 'true' : 'false'}>
        <span class="w">{p.lines.join(' ')}</span>
        <span class="tr-fr" data-l="fr">{p.fr}</span><span class="tr-en" data-l="en">{p.en}</span>
      </button>
    ))}
  </div>
  <h2 class="fallback">{PHRASES[0].lines[0]}<br />{PHRASES[0].lines[1]}<span>.</span></h2>
  <slot />
</HeroShell>

<style>
  .hud { position: absolute; inset: 0; pointer-events: none; font: 500 11px/1.5 ui-monospace, 'SF Mono', Menlo, Consolas, monospace; letter-spacing: .14em; color: rgba(201, 184, 255, .62); }
  .corner { position: absolute; width: 18px; height: 18px; border-color: rgba(201, 184, 255, .45); border-style: solid; border-width: 0; }
  .tl { left: 24px; top: 88px; border-left-width: 1px; border-top-width: 1px; }
  .tr { right: 24px; top: 88px; border-right-width: 1px; border-top-width: 1px; }
  .bl { left: 24px; bottom: 24px; border-left-width: 1px; border-bottom-width: 1px; }
  .br { right: 24px; bottom: 24px; border-right-width: 1px; border-bottom-width: 1px; }
  .lbl { position: absolute; white-space: nowrap; }
  .l-tl { left: 50px; top: 92px; }
  .l-tr { right: 50px; top: 92px; text-align: right; }
  .l-bl { left: 50px; bottom: 48px; }
  .l-br { right: 50px; bottom: 92px; }
  [data-free] { display: inline-block; min-width: 5ch; text-align: left; }
  .sub { left: 50%; transform: translateX(-50%); top: 74%; color: rgba(201, 184, 255, .7); letter-spacing: .32em; text-transform: uppercase; transition: opacity .8s ease; }
  .tch { display: none; }
  @media (hover: none) { .ms { display: none; } .tch { display: inline; } }
  .phrases {
    position: absolute; left: 50%; bottom: 112px; transform: translateX(-50%); z-index: 2; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; pointer-events: auto;
    width: max-content; max-width: min(1100px, calc(100% - 100px)); padding: 4px;
  }
  .phrases::-webkit-scrollbar { display: none; }
  .ph {
    flex: none; display: flex; flex-direction: column; align-items: center; gap: 1px; padding: 6px 12px; border-radius: 12px; cursor: pointer;
    border: 1px solid rgba(201, 184, 255, .18); background: rgba(15, 14, 20, .45); color: rgba(243, 239, 248, .62);
    font: 600 10.5px/1.3 ui-monospace, 'SF Mono', Menlo, Consolas, monospace; letter-spacing: .14em; transition: border-color .2s, color .2s, background .2s;
  }
  .ph [data-l] { font-weight: 400; font-size: 9.5px; letter-spacing: .04em; color: rgba(169, 163, 184, .8); text-transform: none; }
  .phrases.compact .ph [data-l] { display: none; }
  @media (max-width: 1279px) { .l-br { display: none; } }   /* le timecode laisserait trop peu de place aux boutons */
  .ph:hover, .ph:focus-visible { border-color: rgba(201, 184, 255, .5); color: #f3eff8; outline: none; }
  .ph.on { border-color: rgba(158, 97, 255, .75); background: rgba(110, 70, 220, .22); color: #f3eff8; }
  :global(.hero-shell.nogl) .phrases { display: none; }
  .fallback { display: none; }
  :global(.hero-shell.nogl) .fallback {
    display: block; position: absolute; left: 50%; top: 48%; transform: translate(-50%, -50%); margin: 0; text-align: center;
    font: 900 clamp(2.4rem, 9vw, 9rem)/1.02 'Unbounded', 'Arial Black', 'Helvetica Neue', Arial, sans-serif;
    background: linear-gradient(90deg, #9e61ff, #4285ff); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  :global(.hero-shell.nogl) .fallback span { color: #4fe3ff; }
  :global(.hero-shell[data-hero="kinetic"]) { background: radial-gradient(ellipse at 50% 45%, #1a1240, #07060c 70%); }
  :global(.hero-shell[data-hero="kinetic"]) { cursor: crosshair; }
  @media (max-width: 820px) {
    .l-tr { display: none; }
    .l-tl { top: 140px; } .tl, .tr { top: 136px; }
    .l-bl { bottom: 46px; font-size: 10px; } .l-br { bottom: 46px; display: none; }
    .sub { font-size: 10px; letter-spacing: .22em; }
    .phrases { left: 12px; right: 12px; transform: none; width: auto; max-width: none; bottom: 74px; flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; scrollbar-width: none; }
    .ph [data-l] { display: none; }
  }
</style>

<script>
  // ───────── CONFIG ─────────
  let LINES = ['SELECTIO', 'NATURALIS'];   // texte de départ (remplacé par le premier bouton du HTML), une entrée par ligne
  const COUNT_DESKTOP = 24000;  // particules visées sur ordinateur (10 000 à 30 000)
  const COUNT_MOBILE = 9000;    // particules visées sur petit écran
  const DUST = 420;             // poussière d'ambiance autour du nom (0 pour désactiver)
  // police (chargée depuis Google Fonts en haut du fichier) ; width = largeur visée de la ligne la plus longue
  const FONT = { family: 'Unbounded', weight: 900, width: 0.8, mobileWidth: 0.9, lineGap: 1.06 };
  const font = (px: number) => `${FONT.weight} ${px}px "${FONT.family}", 'Arial Black', 'Helvetica Neue', Arial, sans-serif`;
  const CENTER_Y = 0.47;        // centre vertical du nom (part de la hauteur)
  // dégradé violet -> bleu sur la largeur du nom, cyan et vert d'eau pour les particules rapides
  const GRAD_FROM = [0.62, 0.38, 1.0], GRAD_TO = [0.26, 0.52, 1.0];
  const CYAN = [0.31, 0.89, 1.0], AQUA = [0.36, 1.0, 0.68];
  // souris
  const REPEL_RADIUS = 110;     // px : rayon du champ de répulsion (réduit sur mobile)
  const REPEL_FORCE = 2600;     // px/s² au centre
  const VORTEX = 1.5;           // force du tourbillon, proportionnelle à la vitesse du curseur
  const DRAG = 0.9;             // part de la vitesse du curseur transmise aux particules
  // clic
  const BLAST_RADIUS = 210;     // px
  const BLAST_FORCE = 1500;     // px/s d'impulsion au centre
  // retour
  const HOLD = 0.35;            // s : délai avant que la particule dérangée ne revienne
  const STAGGER = 0.45;         // s : délai aléatoire supplémentaire par particule (retour en vague)
  const RAMP = 0.9;             // s : montée progressive du ressort
  const SPRING = 34;            // raideur du ressort (1/s²)
  const DAMPING = 0.72;         // amortissement relatif (1 = critique, < 1 léger dépassement élégant)
  const FRICTION = 2.2;         // freinage des particules libres (1/s)
  // rendu
  const POINT = 1.7;            // taille des points relative à l'espacement d'échantillonnage
  const ALPHA = 0.6;            // opacité de chaque point (mélange additif)
  const SHIMMER = 0.45;         // px : frémissement au repos (le nom reste net)
  const INTRO = 1.6;            // s : assemblage du nom à l'arrivée

  const root = document.querySelector<HTMLElement>('[data-hero="kinetic"]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const canvas = root.querySelector('canvas')!;
    const gl = canvas.getContext('webgl2', { alpha: false, antialias: false, depth: false, stencil: false, powerPreference: 'high-performance' });
    if (!gl) { root.classList.add('nogl'); return; }
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = Math.min(innerWidth, innerHeight) < 700;

    // ───────── shaders ─────────
    const BG_VS = `#version 300 es
      in vec2 aQuad; out vec2 vUv;
      void main() { vUv = aQuad * .5 + .5; gl_Position = vec4(aQuad, 0., 1.); }`;
    const BG_FS = `#version 300 es
      precision highp float; in vec2 vUv; out vec4 o; uniform vec2 uRes;
      void main() {
        vec2 q = (vUv - vec2(.5, .55)) * vec2(uRes.x / uRes.y, 1.);
        float g = exp(-dot(q, q) * 2.2);
        vec3 col = mix(vec3(.027, .024, .047), vec3(.102, .071, .251), g * .85);
        col += (fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453) - .5) / 255.;   // anti-banding
        o = vec4(col, 1.);
      }`;
    // aDyn = (x, y, vitesse) en px CSS ; aStat = (position dans le dégradé, graine, type 0 lettre / 1 point / 2 poussière)
    const P_VS = `#version 300 es
      precision highp float;
      in vec3 aDyn; in vec3 aStat;
      uniform vec2 uRes; uniform float uTime, uSize, uDpr, uShimmer;
      uniform vec3 uFrom, uTo, uCyan, uAqua;
      out vec3 vCol; out float vA;
      void main() {
        float seed = aStat.y, kind = aStat.z;
        float sp = clamp(aDyn.z / 900., 0., 1.);
        // frémissement : petite orbite propre à chaque particule (plus ample pour la poussière)
        float amp = uShimmer * (kind > 1.5 ? 7. : 1.);
        float ph = seed * 6.2831;
        vec2 jit = amp * vec2(sin(uTime * (1.1 + seed) + ph), cos(uTime * (1.4 + seed * .7) + ph * 1.7));
        vec2 p = aDyn.xy + jit;
        gl_Position = vec4(p / uRes * 2. - 1., 0., 1.); gl_Position.y *= -1.;
        vec3 base = mix(uFrom, uTo, smoothstep(0., 1., aStat.x)) * (1.08 - .2 * (aDyn.y / uRes.y - .3));   // léger éclairage vertical, comme "Concept"
        vec3 hot = mix(uCyan, uAqua, fract(seed * 7.13));
        vec3 col = mix(base, hot, smoothstep(.05, .8, sp) * .85);
        col *= 1. + sp * 1.1;                                         // plus lumineuses quand elles filent
        float tw = .9 + .1 * sin(uTime * 2.3 + ph * 3.);              // scintillement très léger
        float a = ${ALPHA.toFixed(3)} * tw;
        float s = uSize * (1. + sp * .6);
        if (kind > .5 && kind < 1.5) { col = mix(uCyan, uAqua, .25) * (1.35 + .2 * sin(uTime * 2.4)); }   // point final cyan
        if (kind > 1.5) { a *= .32; s *= .9; col = mix(base, vec3(.79, .72, 1.), .4); }
        vCol = col; vA = a;
        gl_PointSize = max(1., s * uDpr);
      }`;
    const P_FS = `#version 300 es
      precision highp float; in vec3 vCol; in float vA; out vec4 o;
      void main() {
        vec2 c = gl_PointCoord * 2. - 1.;
        float r = dot(c, c);
        float m = exp(-r * 3.2) * (1. - smoothstep(.7, 1., r));       // point rond et doux
        o = vec4(vCol * m * vA, 1.);
      }`;

    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s);
      if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) || 'shader');
      return s;
    };
    const program = (vs: string, fs: string, attrs: string[]) => {
      const p = gl.createProgram()!;
      gl.attachShader(p, compile(gl.VERTEX_SHADER, vs)); gl.attachShader(p, compile(gl.FRAGMENT_SHADER, fs));
      attrs.forEach((a, i) => gl.bindAttribLocation(p, i, a));
      gl.linkProgram(p);
      if (!gl.getProgramParameter(p, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p) || 'link');
      const u: Record<string, WebGLUniformLocation | null> = {};
      const n = gl.getProgramParameter(p, gl.ACTIVE_UNIFORMS);
      for (let i = 0; i < n; i++) { const name = gl.getActiveUniform(p, i)!.name; u[name] = gl.getUniformLocation(p, name); }
      return { p, u };
    };
    let bgProg: ReturnType<typeof program>, ptProg: ReturnType<typeof program>;
    try {
      bgProg = program(BG_VS, BG_FS, ['aQuad']);
      ptProg = program(P_VS, P_FS, ['aDyn', 'aStat']);
    } catch (e) { console.error(e); root.classList.add('nogl'); return; }

    // géométrie : un quad pour le fond, deux tampons pour les particules
    const bgVao = gl.createVertexArray()!; gl.bindVertexArray(bgVao);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0); gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    const ptVao = gl.createVertexArray()!; gl.bindVertexArray(ptVao);
    const dynBuf = gl.createBuffer()!, statBuf = gl.createBuffer()!;
    gl.bindBuffer(gl.ARRAY_BUFFER, dynBuf); gl.enableVertexAttribArray(0); gl.vertexAttribPointer(0, 3, gl.FLOAT, false, 0, 0);
    gl.bindBuffer(gl.ARRAY_BUFFER, statBuf); gl.enableVertexAttribArray(1); gl.vertexAttribPointer(1, 3, gl.FLOAT, false, 0, 0);
    gl.bindVertexArray(null);

    // ───────── état des particules (tableaux typés, simulation sur le CPU) ─────────
    let N = 0, cap = 0;
    let px = new Float32Array(0), py = new Float32Array(0), vx = new Float32Array(0), vy = new Float32Array(0);
    let hx = new Float32Array(0), hy = new Float32Array(0), wake = new Float32Array(0), lag = new Float32Array(0);
    let dyn = new Float32Array(0), stat = new Float32Array(0);
    let spacing = 2, W = 1, H = 1, dpr = 1, unit = 1;   // unit : échelle des interactions, suit la taille du texte

    // échantillonnage du nom sur un canvas hors écran
    const off = document.createElement('canvas');
    const octx = off.getContext('2d', { willReadFrequently: true })!;
    const sub = root.querySelector<HTMLElement>('[data-sub]');
    const sample = () => {
      const w = Math.max(1, Math.round(W)), h = Math.max(1, Math.round(H));
      off.width = w; off.height = h;
      octx.clearRect(0, 0, w, h);
      // taille : la ligne la plus longue occupe FONT.width de l'écran, le bloc reste entre la nav et la barre du bas
      octx.font = font(100);
      const longest = Math.max(...LINES.map((l) => octx.measureText(l).width));
      const m = octx.measureText('FERDINAND');   // hauteur de capitale de référence
      const capH = (m.actualBoundingBoxAscent || 72) / 100;
      const wFrac = w < 820 ? FONT.mobileWidth : FONT.width;
      let size = Math.min((w * wFrac) / longest * 100, (h * 0.5) / (capH * (1 + FONT.lineGap * (LINES.length - 1))));
      // sur ordinateur, le texte et sa consigne doivent tenir au-dessus des boutons de devise (posés en bas)
      const chipsEl = root.querySelector<HTMLElement>('.phrases');
      chipsEl?.classList.toggle('compact', w < 1280);   // sans traduction, sur une seule ligne
      if (w >= 820 && chipsEl) {
        const chipTop = h - 96 - chipsEl.offsetHeight;
        const B = capH + (LINES.length - 1) * (capH * FONT.lineGap + 0.24);
        size = Math.min(size, (chipTop - 30 - h * CENTER_Y) / (B / 2 + 0.42));
      }
      size = Math.max(18, size);
      unit = Math.min(1.3, Math.max(0.42, size / 175));
      octx.font = font(size);
      octx.textAlign = 'center'; octx.textBaseline = 'alphabetic'; octx.fillStyle = '#fff';
      const lineH = size * capH * (1 + (FONT.lineGap - 1)) + size * 0.24;
      const blockH = size * capH + lineH * (LINES.length - 1);
      const top = h * CENTER_Y - blockH / 2;
      let maxRight = 0, lastBase = 0, lastRight = 0;
      LINES.forEach((l, i) => {
        const base = top + size * capH + i * lineH;
        octx.fillText(l, w / 2, base);
        const lw = octx.measureText(l).width;
        maxRight = Math.max(maxRight, w / 2 + lw / 2);
        lastBase = base; lastRight = w / 2 + lw / 2;
      });
      if (sub) sub.style.top = `${((lastBase + size * 0.42) / h) * 100}%`;
      // boutons de devise juste sous la consigne (sur ordinateur), sans descendre sur la barre du bas
      const chips = root.querySelector<HTMLElement>('.phrases');
      if (chips) {
        if (w >= 820) {
          // en bas de l'écran, juste au-dessus de la ligne du bouton « Retour au lab »
          const top = h - 96 - chips.offsetHeight;
          chips.style.top = `${top}px`; chips.style.bottom = 'auto';
        } else { chips.style.top = ''; chips.style.bottom = ''; }
      }
      const data = octx.getImageData(0, 0, w, h).data;
      // densité : on compte les pixels pleins pour viser le nombre de particules voulu
      let filled = 0, minX = w, maxX = 0;
      for (let y = 0; y < h; y += 2) for (let x = 0; x < w; x += 2) if (data[(y * w + x) * 4 + 3] > 128) { filled += 4; if (x < minX) minX = x; if (x > maxX) maxX = x; }
      const area = Math.min(w * h, 1600 * 1000);
      const target = (mobile ? COUNT_MOBILE : COUNT_DESKTOP) * Math.min(1, Math.max(0.45, (w * h) / area));
      spacing = Math.max(1, Math.sqrt(filled / Math.max(1, target)));
      const out: number[] = [];
      for (let gy = 0; gy < h; gy += spacing) for (let gx = 0; gx < w; gx += spacing) {
        const x = gx + Math.random() * spacing, y = gy + Math.random() * spacing;   // échantillonnage stratifié : régulier mais organique
        const ix = Math.min(w - 1, x | 0), iy = Math.min(h - 1, y | 0);
        if (data[(iy * w + ix) * 4 + 3] > 140) out.push(x, y, (x - minX) / Math.max(1, maxX - minX), 0);
      }
      // point final cyan après la dernière ligne, en clin d'œil à "Concept"
      const dr = size * 0.075, dcx = lastRight + size * 0.2, dcy = lastBase - dr;
      const ds = spacing * 0.8;
      for (let y = -dr; y <= dr; y += ds) for (let x = -dr; x <= dr; x += ds) if (x * x + y * y <= dr * dr) out.push(dcx + x, dcy + y, 1, 1);
      // poussière d'ambiance, répartie sur tout l'écran mais plus dense près du nom
      const dust = mobile ? Math.round(DUST * 0.5) : DUST;
      for (let i = 0; i < dust; i++) {
        const a = Math.random() * Math.PI * 2, r = Math.sqrt(Math.random());
        out.push(w / 2 + Math.cos(a) * r * w * 0.55, h * CENTER_Y + Math.sin(a) * r * h * 0.46, Math.random(), 2);
      }
      return out;
    };

    // (re)construit les cibles ; les particules existantes glissent vers leurs nouvelles places
    let built = false;
    const build = (intro: boolean) => {
      const pts = sample();
      const n = pts.length / 4;
      const old = { px, py, vx, vy, wake, N };
      if (n > cap) {
        cap = n;
        px = new Float32Array(n); py = new Float32Array(n); vx = new Float32Array(n); vy = new Float32Array(n);
        hx = new Float32Array(n); hy = new Float32Array(n); wake = new Float32Array(n); lag = new Float32Array(n);
        dyn = new Float32Array(n * 3); stat = new Float32Array(n * 3);
      }
      const t = clock();
      for (let i = 0; i < n; i++) {
        hx[i] = pts[i * 4]; hy[i] = pts[i * 4 + 1];
        stat[i * 3] = pts[i * 4 + 2]; stat[i * 3 + 1] = Math.random(); stat[i * 3 + 2] = pts[i * 4 + 3];
        lag[i] = Math.random();
        if (intro) {
          // arrivée : les particules partent d'un nuage diffus et s'assemblent en vague de gauche à droite
          const a = Math.random() * Math.PI * 2, r = (0.35 + Math.random() * 0.75) * Math.max(W, H) * 0.6;
          px[i] = W / 2 + Math.cos(a) * r; py[i] = H * CENTER_Y + Math.sin(a) * r * 0.7;
          vx[i] = -Math.sin(a) * 120; vy[i] = Math.cos(a) * 120;
          wake[i] = t + stat[i * 3] * INTRO * 0.45 + lag[i] * INTRO * 0.3;
        } else if (old.N) {
          const j = i % old.N;
          px[i] = old.px[j]; py[i] = old.py[j]; vx[i] = old.vx[j]; vy[i] = old.vy[j];
          wake[i] = Math.max(t + lag[i] * 0.25, old.wake[j]);
        } else { px[i] = hx[i]; py[i] = hy[i]; vx[i] = vy[i] = 0; wake[i] = -1e9; }
      }
      N = n;
      gl.bindBuffer(gl.ARRAY_BUFFER, statBuf); gl.bufferData(gl.ARRAY_BUFFER, stat.subarray(0, N * 3), gl.STATIC_DRAW);
      gl.bindBuffer(gl.ARRAY_BUFFER, dynBuf); gl.bufferData(gl.ARRAY_BUFFER, dyn.byteLength, gl.DYNAMIC_DRAW);
      const nl = root.querySelector('[data-n]');
      if (nl) nl.textContent = N.toLocaleString('fr-FR').replace(/\s/g, ' ');
      built = true;
    };

    // ───────── pointeur ─────────
    const t0 = performance.now();
    const clock = () => (performance.now() - t0) / 1000;
    const ptr = { x: -1e4, y: -1e4, lx: -1e4, ly: -1e4, vx: 0, vy: 0, on: false };
    const blasts: { x: number; y: number }[] = [];
    const xl = root.querySelector('[data-x]'), yl = root.querySelector('[data-y]');
    const local = (e: PointerEvent) => { const r = root.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top]; };
    root.addEventListener('pointermove', (e) => {
      const [x, y] = local(e);
      if (!ptr.on) { ptr.lx = x; ptr.ly = y; }
      ptr.x = x; ptr.y = y; ptr.on = true;
      if (xl) xl.textContent = `X ${(x / W).toFixed(3)}`; if (yl) yl.textContent = `Y ${(1 - y / H).toFixed(3)}`;
    });
    root.addEventListener('pointerleave', () => { ptr.on = false; });
    root.addEventListener('pointerup', (e) => { if (e.pointerType !== 'mouse') ptr.on = false; });
    root.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      const [x, y] = local(e);
      if (!ptr.on) { ptr.lx = x; ptr.ly = y; }
      ptr.x = x; ptr.y = y; ptr.on = true;
      if (!reduced) blasts.push({ x, y });
    });

    // choix du texte : les particules quittent l'ancien texte et forment le nouveau
    const phraseBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-phrase]')];
    if (phraseBtns[0]) LINES = phraseBtns[0].dataset.phrase!.split('|');
    phraseBtns.forEach((b) => b.addEventListener('click', () => {
      LINES = b.dataset.phrase!.split('|');
      phraseBtns.forEach((o) => { o.classList.toggle('on', o === b); o.setAttribute('aria-pressed', String(o === b)); });
      const fb = root.querySelector('.fallback');
      if (fb) fb.innerHTML = `${LINES[0]}<br />${LINES[1] ?? ''}<span>.</span>`;
      if (!built) return;
      if (!reduced) for (let i = 0; i < N; i++) { const a = Math.random() * Math.PI * 2, f = 260 + Math.random() * 520; vx[i] += Math.cos(a) * f; vy[i] += Math.sin(a) * f; }
      build(false);
      if (reduced) { settle(); render(0); }
    }));

    // ───────── simulation ─────────
    let freeCount = 0;
    const step = (dt: number, t: number) => {
      const R = REPEL_RADIUS * Math.max(0.6, unit), R2 = R * R;
      const omega = Math.sqrt(SPRING), zeta2 = 2 * DAMPING * omega;
      const fr = Math.exp(-FRICTION * dt);
      // vitesse du curseur lissée
      if (ptr.on && dt > 0) {
        ptr.vx += ((ptr.x - ptr.lx) / dt - ptr.vx) * 0.3;
        ptr.vy += ((ptr.y - ptr.ly) / dt - ptr.vy) * 0.3;
      } else { ptr.vx *= 0.85; ptr.vy *= 0.85; }
      ptr.lx = ptr.x; ptr.ly = ptr.y;
      const cs = Math.hypot(ptr.vx, ptr.vy), csN = Math.min(1, cs / 1400);
      const mx = ptr.on ? ptr.x : -1e5, my = ptr.on ? ptr.y : -1e5;
      const BR = BLAST_RADIUS * unit, BR2 = BR * BR, BF = BLAST_FORCE * Math.sqrt(unit);
      let free = 0;
      for (let i = 0; i < N; i++) {
        let x = px[i], y = py[i], ux = vx[i], uy = vy[i];
        // explosion locale : impulsion radiale, un peu de rotation, retour plus tardif
        for (let b = 0; b < blasts.length; b++) {
          const dx = x - blasts[b].x, dy = y - blasts[b].y, d2 = dx * dx + dy * dy;
          if (d2 < BR2) {
            const d = Math.sqrt(d2) + 1e-3, k = 1 - d / BR, f = BF * k * (0.55 + lag[i] * 0.9);
            ux += (dx / d) * f + (-dy / d) * f * 0.35; uy += (dy / d) * f + (dx / d) * f * 0.35;
            wake[i] = Math.max(wake[i], t + HOLD + 0.35 + lag[i] * STAGGER * 1.6 + k * 0.4);
          }
        }
        // répulsion + tourbillon lié à la vitesse du curseur
        const dx = x - mx, dy = y - my, d2 = dx * dx + dy * dy;
        if (d2 < R2) {
          const d = Math.sqrt(d2) + 1e-3, k = 1 - d / R, k2 = k * k;
          const nx = dx / d, ny = dy / d;
          const rep = REPEL_FORCE * k2 * (0.6 + csN * 0.8);
          // le sens du tourbillon dépend du côté de la trajectoire : deux tourbillons contrarotatifs dans le sillage
          const side = Math.sign(ptr.vx * dy - ptr.vy * dx) || 1;
          const sw = VORTEX * cs * k * side;
          ux += (nx * rep - ny * sw) * dt + ptr.vx * DRAG * k2 * dt * 6;
          uy += (ny * rep + nx * sw) * dt + ptr.vy * DRAG * k2 * dt * 6;
          wake[i] = Math.max(wake[i], t + HOLD + lag[i] * STAGGER);
        }
        // ressort amorti, qui ne reprend qu'après le délai, avec une montée douce
        const s = (t - wake[i]) / RAMP;
        const g = s <= 0 ? 0.015 : s >= 1 ? 1 : s * s * (3 - 2 * s);
        if (g < 0.98) free++;
        const ex = hx[i] - x, ey = hy[i] - y;
        ux += (ex * SPRING * g - ux * zeta2 * g) * dt;
        uy += (ey * SPRING * g - uy * zeta2 * g) * dt;
        const f = 1 - (1 - fr) * (1 - g);   // friction de l'air tant que la particule est libre
        ux *= f; uy *= f;
        x += ux * dt; y += uy * dt;
        px[i] = x; py[i] = y; vx[i] = ux; vy[i] = uy;
        const o = i * 3; dyn[o] = x; dyn[o + 1] = y; dyn[o + 2] = Math.sqrt(ux * ux + uy * uy);
      }
      blasts.length = 0;
      freeCount = free;
    };
    const settle = () => { for (let i = 0; i < N; i++) { const o = i * 3; px[i] = dyn[o] = hx[i]; py[i] = dyn[o + 1] = hy[i]; dyn[o + 2] = 0; vx[i] = vy[i] = 0; } };

    // ───────── rendu ─────────
    const render = (t: number) => {
      gl.viewport(0, 0, gl.drawingBufferWidth, gl.drawingBufferHeight);
      gl.disable(gl.BLEND);
      gl.useProgram(bgProg.p); gl.uniform2f(bgProg.u.uRes, W, H);
      gl.bindVertexArray(bgVao); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      if (!N) return;
      gl.enable(gl.BLEND); gl.blendFunc(gl.ONE, gl.ONE);   // mélange additif
      gl.useProgram(ptProg.p);
      const u = ptProg.u;
      gl.uniform2f(u.uRes, W, H); gl.uniform1f(u.uTime, t); gl.uniform1f(u.uDpr, dpr);
      gl.uniform1f(u.uSize, Math.max(1.4, spacing * POINT)); gl.uniform1f(u.uShimmer, reduced ? 0 : SHIMMER);
      gl.uniform3fv(u.uFrom, GRAD_FROM); gl.uniform3fv(u.uTo, GRAD_TO); gl.uniform3fv(u.uCyan, CYAN); gl.uniform3fv(u.uAqua, AQUA);
      gl.bindBuffer(gl.ARRAY_BUFFER, dynBuf); gl.bufferSubData(gl.ARRAY_BUFFER, 0, dyn.subarray(0, N * 3));
      gl.bindVertexArray(ptVao); gl.drawArrays(gl.POINTS, 0, N);
      gl.bindVertexArray(null);
    };

    // ───────── redimensionnement, police ─────────
    const resize = () => {
      const r = root.getBoundingClientRect();
      dpr = Math.min(devicePixelRatio || 1, 2);
      const w = Math.round(r.width * dpr), h = Math.round(r.height * dpr);
      if (canvas.width === w && canvas.height === h && built) return false;
      canvas.width = w; canvas.height = h; W = r.width; H = r.height;
      build(!built && !reduced);
      if (reduced) settle();
      return true;
    };
    const fontReady = (document as any).fonts?.load?.(font(100)) as Promise<unknown> | undefined;
    const refont = () => { if (!built) return; build(false); if (reduced) { settle(); render(0); } };
    fontReady?.then(refont).catch(() => {});
    (document as any).fonts?.ready?.then(refont);

    if (reduced) {
      // image fixe : le nom assemblé, sans mouvement
      const draw = () => { resize(); settle(); render(0); };
      Promise.race([fontReady, new Promise((r) => setTimeout(r, 600))]).finally(draw);
      new ResizeObserver(() => { if (resize()) { settle(); render(0); } }).observe(root);
      if (sub) sub.style.opacity = '0';
      return;
    }

    // ───────── boucle ─────────
    const tc = root.querySelector('[data-tc]'), fl = root.querySelector('[data-free]');
    let last = performance.now(), raf = 0, visible = true, hudTick = 0, started = false;
    const loop = (now: number) => {
      raf = 0;
      if (!visible || document.hidden) return;
      resize();
      const realDt = Math.min((now - last) / 1000, 0.1); last = now;
      const t = clock();
      // pas fixes pour une physique stable même si l'image ralentit
      const steps = Math.min(4, Math.max(1, Math.ceil(realDt / (1 / 60))));
      for (let k = 0; k < steps; k++) step(realDt / steps, t);
      render(t);
      if (++hudTick % 6 === 0) {
        if (fl) fl.textContent = String(freeCount);
        if (tc) { const f = Math.floor((t % 1) * 24), p = (n: number) => String(Math.floor(n)).padStart(2, '0'); tc.textContent = `${p(t / 3600)}:${p((t / 60) % 60)}:${p(t % 60)}:${p(f)}`; }
      }
      raf = requestAnimationFrame(loop);
    };
    const start = () => { if (!raf && started) { last = performance.now(); raf = requestAnimationFrame(loop); } };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) start(); }).observe(root);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
    // on attend un peu la police pour que l'assemblage se fasse directement sur la bonne forme
    Promise.race([fontReady, new Promise((r) => setTimeout(r, 700))]).finally(() => { started = true; resize(); start(); });
  }
</script>

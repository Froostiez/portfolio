---
// Monte Carlo en direct : une grille de FIRE! (le jeu de Ferdi) et, à côté, l'arbre d'un Single-Player MCTS
// qui grandit en temps réel pendant la recherche du nombre minimal de tours. Puis l'IA joue sa meilleure séquence.
import HeroShell from './HeroShell.astro';
import { url } from '../../utils';
const SPR = url('/images/lab/fire/');
---
<HeroShell name="mcts" scrim={false}>
  <div class="hud" aria-hidden="true">
    <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
    <span class="lbl l-tr" data-treelbl>SP-MCTS · UCT + σ<br /><span data-l="fr">ARBRE DE RECHERCHE</span><span data-l="en">SEARCH TREE</span></span>
  </div>

  <div class="tip" data-tip aria-hidden="true">
    <b data-tip-move>A1</b> · <span data-l="fr">coup</span><span data-l="en">move</span> <span data-tip-d>1</span><br />
    <span data-tip-n>0</span> <span data-l="fr">visites</span><span data-l="en">visits</span> · <span data-l="fr">moy.</span><span data-l="en">avg</span> <span data-tip-m>0</span> · min <span data-tip-b>0</span>
  </div>

  <div class="banner" data-banner aria-live="polite">
    <div class="row ai"><span class="who"><span data-l="fr">IA</span><span data-l="en">AI</span></span><b data-ban-ai>0</b><span class="u"><span data-l="fr">tours</span><span data-l="en">turns</span></span></div>
    <div class="row you" data-ban-yourow><span class="who"><span data-l="fr">Vous</span><span data-l="en">You</span></span><b data-ban-you>0</b><span class="u"><span data-l="fr">tours</span><span data-l="en">turns</span></span></div>
    <div class="opt" data-ban-opt><span data-l="fr">optimal prouvé</span><span data-l="en">proven optimal</span></div>
  </div>

  <div class="sub" data-sub>
    <p class="sub-main">
      <span data-ph="fresh"><span data-l="fr">Nouveau niveau : nouvelle forêt, nouveaux murs</span><span data-l="en">New level: new forest, new walls</span></span>
      <span data-ph="search"><span class="n">1.</span> <span data-l="fr">L’IA explore… </span><span data-l="en">The AI explores… </span><b data-p-it>0</b> / <span data-p-bud>0</span> <span data-l="fr">parties simulées</span><span data-l="en">simulated games</span></span>
      <span data-ph="human"><span data-l="fr">Votre partie : tour </span><span data-l="en">Your game: turn </span><b data-p-hturn>0</b> · <span data-p-left>0</span> <span data-l="fr">cases de forêt restantes</span><span data-l="en">forest tiles left</span></span>
      <span data-ph="compare"><span data-l="fr">Votre résultat : </span><span data-l="en">Your result: </span><b data-p-you>0</b> <span data-l="fr">tours. Au tour de l’IA…</span><span data-l="en">turns. Now the AI…</span></span>
      <span data-ph="play"><span class="n">2.</span> <span data-l="fr">L’IA joue sa meilleure séquence : tour </span><span data-l="en">The AI plays its best sequence: turn </span><b data-p-step>0</b> / <span data-p-tot>0</span></span>
      <span data-ph="done"><span class="n">3.</span> <span data-l="fr">Résultat : </span><span data-l="en">Result: </span><b data-p-res>0</b> <span data-l="fr">tours</span><span data-l="en">turns</span> <span class="lbx">(<span data-l="fr">minimum théorique ≥ </span><span data-l="en">theoretical minimum ≥ </span><span data-p-lb>0</span>)</span></span>
    </p>
    <div class="bar"><i data-p-bar></i></div>
    <p class="cta" data-ph="search fresh"><i class="cur"></i><span data-l="fr">À vous : cliquez une case pour tenter de faire mieux que l’IA</span><span data-l="en">Your turn: click a tile to try to beat the AI</span></p>
    <p class="cta" data-ph="human"><span data-l="fr">Continuez jusqu’à ce que toute la forêt ait brûlé. L’IA cherche en parallèle.</span><span data-l="en">Keep going until the whole forest has burnt. The AI keeps searching meanwhile.</span></p>
    <p class="cta soft" data-ph="compare"><span data-l="fr">Puis l’IA joue, et un nouveau niveau est généré.</span><span data-l="en">Then the AI plays, and a new level is generated.</span></p>
    <p class="cta soft rule" data-ph="search"><span data-l="fr">Arrêt dès qu’une séquence atteint la borne (<span data-r-lb>0</span> tours : optimum prouvé), sinon après <span data-r-bud>0</span> parties.</span><span data-l="en">Stops once a sequence reaches the bound (<span data-r-lb>0</span> turns: proven optimum), otherwise after <span data-r-bud>0</span> games.</span></p>
    <p class="reason r-opt" data-ph="search play done"><i class="ok">✓</i><span data-l="fr">Optimal prouvé : la séquence atteint la borne, impossible de faire moins de <b data-r-lb>0</b> tours.</span><span data-l="en">Proven optimal: the sequence reaches the bound, it is impossible to do better than <b data-r-lb>0</b> turns.</span></p>
    <p class="reason r-gap" data-ph="play done"><i class="ko">≈</i><span data-l="fr">Meilleure séquence trouvée, pas prouvée optimale : budget de simulations épuisé, écart de <b data-r-gap>0</b> <span data-r-gapu-fr>tour</span> avec la borne (<span data-r-lb>0</span>).</span><span data-l="en">Best sequence found, not proven optimal: simulation budget used up, <b data-r-gap>0</b> <span data-r-gapu-en>turn</span> above the bound (<span data-r-lb>0</span>).</span></p>
    <p class="hist" data-hist data-ph="search play done compare human"><span class="hk"><span data-l="fr">améliorations</span><span data-l="en">improvements</span></span><span data-hist-list></span></p>
  </div>

  <div class="legend glegend" data-glegend aria-hidden="true">
    <span><img src={`${SPR}DEV_arbre.png`} alt="" /><span data-l="fr">forêt</span><span data-l="en">forest</span></span>
    <span><img src={`${SPR}DEV_arbreenfeu.png`} alt="" /><span data-l="fr">en feu</span><span data-l="en">burning</span></span>
    <span><img src={`${SPR}DEV_brule.png`} alt="" /><span data-l="fr">brûlé</span><span data-l="en">burnt</span></span>
    <span><img class="wall" src={`${SPR}DEV_mur2.png`} alt="" /><span data-l="fr">mur</span><span data-l="en">wall</span><span class="lg"><span data-l="fr"> (bloque le feu)</span><span data-l="en"> (blocks fire)</span></span></span>
    <span><i class="num">1</i><i class="num">2</i><span data-l="fr">cases que l’IA prévoit d’allumer</span><span data-l="en">tiles the AI plans to light</span><span class="lg"><span data-l="fr">, dans l’ordre</span><span data-l="en">, in order</span></span></span>
  </div>

  <div class="legend tlegend" data-tlegend aria-hidden="true">
    <span><i class="qscale"><i></i><i></i><i></i><i></i><i></i></i><span data-l="fr">coup médiocre → bon coup</span><span data-l="en">poor move → good move</span><span class="lg"><span data-l="fr"> (couleur, taille, lueur)</span><span data-l="en"> (colour, size, glow)</span></span></span>
    <span><i class="best"></i><span data-l="fr">meilleure séquence</span><span data-l="en">best sequence</span><span class="lg"><span data-l="fr"> trouvée</span><span data-l="en"> found</span></span></span>
    <span><i class="ring"></i><span class="lg"><span data-l="fr">centre = départ · </span><span data-l="en">centre = start · </span></span><span data-l="fr">1 anneau = 1 tour</span><span data-l="en">1 ring = 1 turn</span></span>
  </div>

  <div class="intro" data-intro>
    <button type="button" class="x" data-intro-close aria-label="Fermer / Close">×</button>
    <p class="kick"><span data-l="fr">Monte Carlo en direct</span><span data-l="en">Live Monte Carlo</span></p>
    <h3><span data-l="fr">Comment ça marche</span><span data-l="en">How it works</span></h3>
    <ol>
      <li><b><span data-l="fr">Le jeu.</span><span data-l="en">The game.</span></b> <span data-l="fr">Dans FIRE!, il faut brûler toute la forêt en un minimum de tours. À chaque tour on allume une case, et le feu se propage aux cases voisines (jamais en diagonale ni à travers un mur).</span><span data-l="en">In FIRE!, you must burn the whole forest in as few turns as possible. Each turn you light one tile, and the fire spreads to neighbouring tiles (never diagonally, never through a wall).</span></li>
      <li><b><span data-l="fr">L’IA.</span><span data-l="en">The AI.</span></b> <span data-l="fr">Elle simule des milliers de parties (Monte Carlo Tree Search), insiste sur les coups prometteurs et garde la meilleure séquence, puis la joue. Le MCTS ne garantit pas l’optimum : on n’est sûr d’avoir la meilleure séquence que si elle atteint la borne inférieure (le minimum théorique).</span><span data-l="en">It simulates thousands of games (Monte Carlo Tree Search), focuses on promising moves and keeps the best sequence, then plays it. MCTS does not guarantee the optimum: the best sequence is only certain when it reaches the lower bound (the theoretical minimum).</span></li>
      <li><b><span data-l="fr">L’arbre.</span><span data-l="en">The tree.</span></b> <span data-l="fr">Le centre est le départ, chaque anneau un tour, chaque branche un coup essayé. Les bons coups sont grands, lumineux et cyan à blanc-vert ; les coups médiocres restent petits et sombres. En orange, la meilleure séquence.</span><span data-l="en">The centre is the start, each ring a turn, each branch a move tried. Good moves are large, bright, cyan to white-green; poor moves stay small and dim. Orange is the best sequence.</span></li>
    </ol>
    <p class="foot"><span data-l="fr">Vous pouvez aussi jouer : cliquez une case de la grille.</span><span data-l="en">You can play too: click a tile on the board.</span></p>
    <div class="intro-actions">
      <button type="button" class="btn go" data-intro-go><span data-l="fr">C’est parti</span><span data-l="en">Let’s go</span></button>
      <a class="btn fire ghost" href="https://fire-vert-pi.vercel.app/" target="_blank" rel="noopener noreferrer"><span data-l="fr">Jouer à FIRE!</span><span data-l="en">Play FIRE!</span> <span aria-hidden="true">↗</span></a>
    </div>
  </div>

  <div class="panel">
    <div class="stats">
      <div class="stat"><span class="k"><span data-l="fr">itérations</span><span data-l="en">iterations</span></span><b data-s-it>0</b></div>
      <div class="stat hot"><span class="k"><span data-l="fr">meilleure</span><span data-l="en">best</span></span><b><span data-s-best>…</span><small><span data-l="fr"> tours</span><span data-l="en"> turns</span></small></b></div>
      <div class="stat lb" data-lbstat tabindex="0"><span class="k"><span data-l="fr">borne inf.</span><span data-l="en">lower bound</span> <i class="qi">?</i></span><b data-s-lb>0</b>
        <span class="pop"><span data-l="fr">Le feu ne gagne qu’une case par tour : même parfaitement joué, ce niveau demande au moins <b data-p-lb2>0</b> tours.</span><span data-l="en">Fire only gains one tile per turn: even with perfect play, this level needs at least <b data-p-lb2>0</b> turns.</span></span>
      </div>
      <div class="stat depth"><span class="k"><span data-l="fr">profondeur</span><span data-l="en">depth</span></span><b data-s-depth>0</b></div>
    </div>
    <div class="controls">
      <button type="button" class="btn" data-new><span data-l="fr">Nouveau niveau</span><span data-l="en">New level</span></button>
      <button type="button" class="btn q" data-help aria-label="Aide / Help">?</button>
      <button type="button" class="btn" data-speed aria-label="Vitesse / Speed"><span class="spw"><span data-l="fr">Vitesse </span><span data-l="en">Speed </span></span><span data-speed-v>×1</span></button>
      <a class="btn fire" href="https://fire-vert-pi.vercel.app/" target="_blank" rel="noopener noreferrer"><span data-l="fr">Jouer à FIRE!</span><span data-l="en">Play FIRE!</span> <span aria-hidden="true">↗</span></a>
      <span class="hint"><span data-l="fr">survolez l’arbre : chaque point est un coup essayé</span><span data-l="en">hover the tree: each dot is a move tried</span></span>
    </div>
  </div>
  <slot />
</HeroShell>

<style>
  /* curseur toujours visible sur ce lab (le brush reveal le masque sur les autres pages plein écran) */
  :global(body.has-hero:has([data-hero="mcts"])) { cursor: default; }
  :global(.hero-shell[data-hero="mcts"]) { cursor: default; }
  :global(.hero-shell[data-hero="mcts"]) { background: radial-gradient(ellipse at 70% 50%, #1b1338 0%, #100d1c 45%, #0b0a10 85%); }
  .hud { position: absolute; inset: 0; pointer-events: none; font: 500 11px/1.5 ui-monospace, 'SF Mono', Menlo, Consolas, monospace; letter-spacing: .14em; color: rgba(201, 184, 255, .6); }
  .corner { position: absolute; width: 18px; height: 18px; border-color: rgba(201, 184, 255, .4); border-style: solid; border-width: 0; }
  .tl { left: 24px; top: 88px; border-left-width: 1px; border-top-width: 1px; }
  .tr { right: 24px; top: 88px; border-right-width: 1px; border-top-width: 1px; }
  .bl { left: 24px; bottom: 24px; border-left-width: 1px; border-bottom-width: 1px; }
  .br { right: 24px; bottom: 24px; border-right-width: 1px; border-bottom-width: 1px; }
  .lbl { position: absolute; white-space: nowrap; }
  .l-tl { left: 50px; top: 92px; }
  .l-tr { right: 50px; top: 92px; text-align: right; }

  .panel {
    position: absolute; left: 50px; bottom: 34px; display: flex; flex-direction: column; gap: 10px;
    font: 500 11px/1.4 ui-monospace, 'SF Mono', Menlo, Consolas, monospace; letter-spacing: .12em; color: #a9a3b8; text-transform: uppercase;
  }
  .stats { align-self: flex-start; display: flex; gap: 1px; border-radius: 14px; overflow: hidden; background: rgba(201, 184, 255, .12); border: 1px solid rgba(201, 184, 255, .14); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .stat { display: flex; flex-direction: column; gap: 2px; padding: 9px 16px 10px; min-width: 104px; background: rgba(16, 13, 28, .72); }
  .stat .k { font-size: 9.5px; letter-spacing: .18em; color: rgba(169, 163, 184, .85); }
  .stat b { font: 600 20px/1.1 ui-monospace, 'SF Mono', Menlo, Consolas, monospace; letter-spacing: .02em; color: #f3eff8; text-transform: none; font-variant-numeric: tabular-nums; }
  .stat b small { font-size: 10px; letter-spacing: .1em; color: #a9a3b8; font-weight: 500; }
  .stat.hot b > span:first-child { color: #ffb27a; text-shadow: 0 0 14px rgba(255, 140, 70, .45); }
  .controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .btn {
    pointer-events: auto; cursor: pointer; font: inherit; letter-spacing: .14em; text-transform: uppercase; color: #e6defc;
    padding: 7px 14px; border-radius: 999px; border: 1px solid rgba(201, 184, 255, .28); background: rgba(24, 20, 40, .6);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); transition: border-color .2s, background .2s, color .2s;
  }
  .btn:hover { border-color: rgba(79, 227, 255, .7); color: #fff; background: rgba(40, 32, 70, .7); }
  .btn:focus-visible { outline: 2px solid #4fe3ff; outline-offset: 2px; }
  .hint { color: rgba(169, 163, 184, .6); font-size: 10px; letter-spacing: .14em; margin-left: 6px; }


  /* sous-titre de phase */
  .sub { position: absolute; left: 50px; top: 104px; z-index: 3; max-width: min(680px, calc(100% - 100px)); pointer-events: none; }
  .sub p { margin: 0; }
  .sub [data-ph] { display: none; }
  :global(.hero-shell[data-phase="fresh"]) .sub span[data-ph~="fresh"],
  :global(.hero-shell[data-phase="search"]) .sub span[data-ph~="search"],
  :global(.hero-shell[data-phase="human"]) .sub span[data-ph~="human"],
  :global(.hero-shell[data-phase="compare"]) .sub span[data-ph~="compare"],
  :global(.hero-shell[data-phase="play"]) .sub span[data-ph~="play"],
  :global(.hero-shell[data-phase="done"]) .sub span[data-ph~="done"] { display: inline; }
  :global(.hero-shell[data-phase="fresh"]) .sub p[data-ph~="fresh"],
  :global(.hero-shell[data-phase="search"]) .sub p[data-ph~="search"],
  :global(.hero-shell[data-phase="human"]) .sub p[data-ph~="human"],
  :global(.hero-shell[data-phase="compare"]) .sub p[data-ph~="compare"],
  :global(.hero-shell[data-phase="play"]) .sub p[data-ph~="play"],
  :global(.hero-shell[data-phase="done"]) .sub p[data-ph~="done"] { display: flex; }
  .sub-main { font: 500 15.5px/1.4 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; color: #f3eff8; letter-spacing: .005em; }
  .sub-main b { color: #ffb27a; font-weight: 650; font-variant-numeric: tabular-nums; }
  .sub-main .n { font: 600 12px/1 ui-monospace, 'SF Mono', Menlo, Consolas, monospace; color: #4fe3ff; margin-right: 2px; }
  :global(.hero-shell[data-phase="search"]) .sub-main b { color: #4fe3ff; }
  .sub-main .lbx { color: #a9a3b8; }
  .optok { display: none; color: #4fe3ff; }
  :global(.hero-shell.opt) .optok { display: inline; }
  .bar { display: none; width: 220px; height: 2px; margin: 8px 0 7px; border-radius: 2px; background: rgba(201, 184, 255, .16); overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #7a5cff, #4fe3ff); box-shadow: 0 0 8px #4fe3ff; }
  :global(.hero-shell[data-phase="search"]) .bar, :global(.hero-shell[data-phase="play"]) .bar { display: block; }
  :global(.hero-shell[data-phase="play"]) .bar i { background: linear-gradient(90deg, #ff9a52, #ffa8cf); box-shadow: 0 0 8px #ff9a52; }
  .cta { align-items: center; gap: 8px; margin-top: 4px !important; font: 500 12.5px/1.4 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; color: #c9b8ff; }
  .cta.soft { color: #a9a3b8; }
  .rule { font-size: 11.5px !important; max-width: 560px; }
  .reason { align-items: baseline; gap: 7px; margin-top: 6px !important; font: 500 12.5px/1.45 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; color: #d8d1ea; max-width: 600px; }
  .reason b { font-weight: 700; }
  .reason i { font-style: normal; flex: none; display: inline-grid; place-items: center; width: 16px; height: 16px; border-radius: 50%; font: 700 10px/1 ui-monospace, Menlo, monospace; transform: translateY(2px); }
  .reason .ok { color: #0f0e14; background: #7dffc8; box-shadow: 0 0 10px rgba(125, 255, 200, .6); }
  .r-opt b { color: #7dffc8; }
  .reason .ko { color: #ffb27a; border: 1px solid rgba(255, 178, 122, .6); }
  .r-gap b { color: #ffb27a; }
  /* la raison affichée dépend de la preuve : borne atteinte ou non */
  :global(.hero-shell:not(.opt)) .sub .r-opt, :global(.hero-shell.opt) .sub .r-gap { display: none !important; }
  :global(.hero-shell.opt[data-phase="search"]) .sub .rule { display: none !important; }
  .hist { align-items: center; gap: 8px; margin-top: 7px !important; font: 500 10.5px/1.4 ui-monospace, 'SF Mono', Menlo, Consolas, monospace; letter-spacing: .04em; color: #a9a3b8; flex-wrap: wrap; }
  .hist:has([data-hist-list]:empty) { display: none !important; }
  .hk { font-size: 9px; letter-spacing: .18em; text-transform: uppercase; color: rgba(169, 163, 184, .7); }
  /* éléments créés en JS : styles globaux (pas d'attribut de portée Astro) */
  .hist :global(.it) { white-space: nowrap; }
  .hist :global(.it + .it)::before { content: '·'; margin: 0 8px 0 7px; color: rgba(169, 163, 184, .5); }
  .hist :global(.it b) { color: #f3eff8; font-weight: 600; }
  .hist :global(.it.new b) { color: #7dffc8; text-shadow: 0 0 10px rgba(125, 255, 200, .8); }
  .hist.flash :global(.it.new) { animation: pop 1.2s ease-out; }
  @keyframes pop { 0% { background: rgba(125, 255, 200, .25); border-radius: 6px; } 100% { background: transparent; } }
  .btn.fire { text-decoration: none; display: inline-block; color: #ffd2ad; border-color: rgba(255, 150, 74, .65); background: linear-gradient(135deg, rgba(255, 120, 60, .18), rgba(255, 168, 207, .1)); box-shadow: 0 0 18px rgba(255, 140, 70, .18); }
  .btn.fire:hover { color: #fff; border-color: #ff9a4a; background: linear-gradient(135deg, rgba(255, 120, 60, .3), rgba(255, 168, 207, .16)); }
  .intro-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .cur { width: 8px; height: 8px; border-radius: 50%; border: 1.5px solid #c9b8ff; box-shadow: 0 0 8px rgba(201, 184, 255, .7); animation: blink 1.6s ease-in-out infinite; flex: none; }
  @keyframes blink { 50% { opacity: .35; } }

  /* légendes */
  .legend { position: absolute; z-index: 3; pointer-events: none; display: flex; flex-wrap: wrap; gap: 6px 14px; font: 500 11px/1.3 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; color: rgba(169, 163, 184, .9); }
  .legend > span { display: inline-block; white-space: nowrap; }
  .legend > span > img, .legend > span > i { vertical-align: middle; margin: -2px 6px 0 0; }
  .legend > span > i.num { margin-right: 3px; }
  .legend > span > i.num + span { margin-left: 3px; }
  .legend img { width: 16px; height: 16px; image-rendering: pixelated; }
  .legend img.wall { width: 16px; height: 8px; }
  .legend .num { display: inline-grid; place-items: center; width: 14px; height: 14px; border-radius: 50%; border: 1.2px solid #4fe3ff; color: #4fe3ff; font: 700 8px/1 ui-monospace, Menlo, monospace; font-style: normal; box-shadow: 0 0 6px rgba(79, 227, 255, .5); text-indent: 0; }
  .tlegend { right: 50px; top: 136px; flex-direction: column; align-items: flex-end; gap: 6px; }
  .tlegend i { display: inline-block; }
  .tlegend .qscale { display: inline-flex !important; align-items: center; gap: 4px; }
  .qscale i { display: block; border-radius: 50%; }
  .qscale i:nth-child(1) { width: 3px; height: 3px; background: rgb(52, 40, 120); }
  .qscale i:nth-child(2) { width: 4px; height: 4px; background: rgb(108, 82, 220); }
  .qscale i:nth-child(3) { width: 6px; height: 6px; background: rgb(79, 200, 255); box-shadow: 0 0 5px rgba(79, 200, 255, .7); }
  .qscale i:nth-child(4) { width: 8px; height: 8px; background: rgb(110, 245, 255); box-shadow: 0 0 8px rgba(110, 245, 255, .9); }
  .qscale i:nth-child(5) { width: 10px; height: 10px; background: rgb(215, 255, 232); box-shadow: 0 0 12px 2px rgba(150, 255, 210, .9); }

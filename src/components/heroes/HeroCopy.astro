---
// Titre type page d'accueil, pour prévisualiser un hero du lab en situation.
---
<div class="hero-copy">
  <span class="eyebrow">Portfolio &amp; Lab</span>
  <h1>Code<br />Data<br /><span data-l="en">Curiosity</span><span data-l="fr">Curiosité</span></h1>
</div>

<style>
  .hero-copy { position: absolute; left: 28px; bottom: 32px; }
  .eyebrow {
    display: inline-block; padding: 6px 14px; border-radius: 999px; font-size: .8rem; letter-spacing: .06em; text-transform: uppercase;
    background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.25); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  h1 {
    margin: 14px 0 0; font-size: 3.8vw; line-height: .88; letter-spacing: -0.03em; font-weight: 800; text-transform: uppercase;
    filter: blur(var(--title-blur, 0px)); transition: filter .12s linear;
  }
  @media (max-width: 820px) { h1 { font-size: 9vw; } .hero-copy { left: 18px; bottom: 24px; } }
</style>

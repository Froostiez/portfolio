---
// Cadre commun des heroes du lab : plein écran, un canvas, un voile en bas, le contenu par-dessus.
const { name, scrim = true } = Astro.props;
---
<section class="hero-shell" data-hero={name}>
  <canvas aria-hidden="true"></canvas>
  {scrim && <div class="scrim" aria-hidden="true"></div>}
  <div class="content"><slot /></div>
</section>

<style>
  .hero-shell {
    position: relative; width: 100%; height: 100svh; min-height: 480px; overflow: hidden;
    color: #fff; background: var(--bg); touch-action: none; user-select: none; -webkit-user-select: none;
  }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .scrim { position: absolute; left: 0; right: 0; bottom: 0; height: 42%; z-index: 2; pointer-events: none; background: linear-gradient(to top, rgba(10,8,20,.55), transparent); }
  .content { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .content :global(a), .content :global(button) { pointer-events: auto; }
</style>

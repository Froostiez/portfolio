    };
    const step = () => { physStep(); if (shPhase === 'out') flyStep(H); };

    // ───────── HUD ─────────
    const q = (s: string) => root.querySelector<HTMLElement>(s);
    const slowRow = q('[data-slowrow]'), slowEl = q('[data-slow]'), tcEl = q('[data-tc]');
    const verdictEl = q('[data-verdict]'), tauIn = q('[data-tau]') as HTMLInputElement | null, tauV = q('[data-tauv]');
    const setTxt = (s: string, v: string) => { const el = q(s); if (el) el.textContent = v; };
    const bi = (a: string, b: string) => `<span data-l="fr">${a}</span><span data-l="en">${b}</span>`;
    const dec = (v: number, d: number) => [v.toFixed(d).replace('.', ','), v.toFixed(d)];
    const meas = () => { const r = cfg.rk.meas[cfg.add]; return r ? { lo: Math.min(...r), hi: Math.max(...r) } : null; };
    // échelle logarithmique du curseur τ₁
    const tauFromIn = (v: number) => TAU_MIN * Math.pow(TAU_MAX / TAU_MIN, v / 1000);
    const inFromTau = (t: number) => Math.round((1000 * Math.log(t / TAU_MIN)) / Math.log(TAU_MAX / TAU_MIN));
    if (tauIn) tauIn.value = String(inFromTau(TAU_DEFAULT));
    let still = () => {};
    const refreshParams = () => {
      const p = model();
      setTxt('[data-k]', cfg.rk.Kexp.toFixed(1)); setTxt('[data-kth]', cfg.rk.Kth.toFixed(1)); setTxt('[data-e]', String(cfg.rk.E));
      setTxt('[data-w0]', p.w0.toFixed(1)); setTxt('[data-wt]', p.wt.toFixed(2));
      if (tauV) tauV.textContent = `${Math.round(cfg.tau * 1000)} ms`;
      masses.forEach((o, i) => { o.visible = cfg.add >= [40, 90, 180][i]; });
      const m = meas(), mEl = q('[data-meas]');
      if (mEl) mEl.innerHTML = m ? bi(`${dec(m.lo, 2)[0]} à ${dec(m.hi, 2)[0]}`, `${dec(m.lo, 2)[1]} to ${dec(m.hi, 2)[1]}`) : bi('non mesuré', 'not measured');

    };
    const segBind = (sel: string, on: (v: string) => void) => {
      const box = q(sel); if (!box) return;
      box.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
        box.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b));
        on(b.dataset.v!); refreshParams(); if (reduced) still();
      }));
    };
    segBind('[data-rk]', (v) => { cfg.rk = RACKETS[v]; });
    segBind('[data-mass]', (v) => { cfg.add = +v; });
    tauIn?.addEventListener('input', () => { cfg.tau = tauFromIn(+tauIn.value); refreshParams(); if (reduced) still(); });

    function showResult() {
      const p = st.p, ratio = st.maxVT / Math.max(1e-6, st.maxVM), gain = (ratio - 1) * 100;
      setTxt('[data-dmax]', `${(st.maxD * 1000).toFixed(0)} mm`);
      setTxt('[data-vm]', `${st.maxVM.toFixed(1)} m/s`);
      setTxt('[data-vt]', `${st.maxVT.toFixed(1)} m/s`);
      setTxt('[data-gainv]', `${gain >= 0 ? '+' : '−'}${Math.abs(gain).toFixed(0)} %`);
      setTxt('[data-vs]', st.vShuttle ? `${(st.vShuttle * 3.6).toFixed(0)} km/h` : '–');
      if (!verdictEl) return;
      const [rf, re] = dec(ratio, 2), [wf, we] = dec(p.wt, 2), m = meas();
      const mf = m ? ` Mesuré au TIPE dans cette configuration : ${dec(m.lo, 2)[0]} à ${dec(m.hi, 2)[0]}.` : '';
      const me = m ? ` Measured in my TIPE for this setup: ${dec(m.lo, 2)[1]} to ${dec(m.hi, 2)[1]}.` : '';
      let a: string, b: string;
      if (p.wt < 0.3) {
        a = `<b>Swing lent (ω̃ = ${wf})</b> : la tige suit presque le manche, la tête ne va que ${rf} fois plus vite.`;
        b = `<b>Slow swing (ω̃ = ${we})</b>: the shaft almost follows the handle, the head is only ${re} times faster.`;
      } else if (p.wt <= 1.15) {
        a = `<b>Effet fouet (ω̃ = ${wf})</b> : la tête atteint ${rf} fois la vitesse du manche (optimum théorique : 1,77 vers ω̃ ≈ 0,6).`;
        b = `<b>Whip effect (ω̃ = ${we})</b>: the head reaches ${re} times the handle speed (theoretical optimum: 1.77 near ω̃ ≈ 0.6).`;
      } else if (ratio >= 1) {
        a = `<b>Au-delà de l’optimum (ω̃ = ${wf})</b> : la tige est trop souple pour ce swing, le gain retombe (${rf} fois la vitesse du manche).`;
        b = `<b>Past the optimum (ω̃ = ${we})</b>: the shaft is too soft for this swing, the gain drops (${re} times the handle speed).`;
      } else {
        a = `<b>Swing trop rapide pour cette tige (ω̃ = ${wf})</b> : la tête n’a pas le temps de rattraper le manche (${rf} fois).`;
        b = `<b>Swing too fast for this shaft (ω̃ = ${we})</b>: the head cannot catch up with the handle (${re} times).`;
      }
      verdictEl.innerHTML = bi(a + mf, b + me);
    }

    // oscilloscope : vitesses du manche et de la tête (haut), déflexion δ(t) (bas)
    const scope = q('[data-scope]') as HTMLCanvasElement, sctx = scope.getContext('2d')!;
    const fit = (c: HTMLCanvasElement) => {
      const dpr = Math.min(devicePixelRatio || 1, 2), W = Math.round(c.clientWidth * dpr), Hh = Math.round(c.clientHeight * dpr);
      if (W && Hh && (c.width !== W || c.height !== Hh)) { c.width = W; c.height = Hh; }
      return { dpr, W, Hh };
    };
    const drawScope = () => {
      const { dpr, W, Hh } = fit(scope); if (!W || !Hh) return;
      sctx.clearRect(0, 0, W, Hh);
      sctx.lineWidth = 1; sctx.strokeStyle = 'rgba(201,184,255,.08)'; sctx.beginPath();
      for (let i = 1; i < 8; i++) { const x = Math.round((W * i) / 8) + 0.5; sctx.moveTo(x, 0); sctx.lineTo(x, Hh); }
      sctx.stroke();
      const base = Hh * 0.6, dTop = base + 4 * dpr;
      sctx.strokeStyle = 'rgba(201,184,255,.22)'; sctx.beginPath(); sctx.moveTo(0, Math.round(base) + 0.5); sctx.lineTo(W, Math.round(base) + 0.5); sctx.stroke();

    };

    // ───────── volant : sur la trajectoire de la tête, puis en vol ─────────
    const sh = { p: new THREE.Vector3(), v: new THREE.Vector3(), axis: new THREE.Vector3(), w: new THREE.Vector3(), spin: 0 };
    const tmpA = new THREE.Vector3(), tmpB = new THREE.Vector3();

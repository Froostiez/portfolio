</style>

<script>
  import * as THREE from 'three';
  import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';

  // ───────── CONFIG ─────────
  // Les deux raquettes du TIPE (mesures et caractéristiques tirées des diapositives)
  type Racket = { id: string; name: string; M: number; L: number; E: number; Kexp: number; Kth: number; meas: Record<number, number[]> };
  const RACKETS: Record<string, Racket> = {
    // M en kg, L en mm, E en GPa, K en mm/N ; meas : rapports v_tête / v_manche mesurés (3 traitements) selon la masse ajoutée en tête (g)
    perfly: { id: 'perfly', name: 'Perfly Lite BR560', M: 0.080, L: 675, E: 230, Kexp: 9.9, Kth: 9.1, meas: { 40: [1.27, 0.99, 0.90], 90: [1.24, 1.13, 0.92], 180: [1.17, 0.84, 0.79] } },
    babolat: { id: 'babolat', name: 'Babolat Speedlighter', M: 0.105, L: 662, E: 200, Kexp: 7.5, Kth: 7.0, meas: { 0: [0.97, 0.91, 0.91], 40: [0.93, 0.88, 0.90], 90: [1.28, 0.76, 0.91], 180: [1.24, 0.62, 0.66] } },
  };
  const M_EQ = 0.23;          // masse équivalente de la poutre : m = 0,23 M (+ masse ajoutée en tête), comme dans le TIPE
  const ZETA = 0.05;          // amortissement réduit (absent du modèle du TIPE, ajouté pour que la tige s'apaise)
  const A_SWING = 0.15;       // m, demi-course du manche : x_M(t) = -a cos(ωt) avec ω = π / τ₁
  const TAU_MIN = 0.03, TAU_MAX = 0.4, TAU_DEFAULT = 0.07;   // s, bornes et valeur par défaut de τ₁ (durée du swing)
  const STUDY_PEAK = 1.77, STUDY_WT = 0.6;                    // optimum de l'étude de référence
  const E_SHUTTLE = 0.75;     // coefficient de restitution volant / tamis (estimation de la vitesse du volant)
  const M_SHUTTLE = 0.0052;   // kg
  const CONTACT_FRAC = 0.55;  // position du volant sur la course de la tête (en fraction de a)
  const SWING_REAL = 5.2;     // s (temps réel) pour montrer le swing et l'oscillation de la tige au ralenti
  const VIS_MAX = 0.17;       // m, déflexion maximale affichée à l'écran (saturation douce au-delà)
  const ARM = 0.6;            // m, distance entre l'axe de l'épaule et la raquette
  const V_TERM = 6.8;         // m/s, vitesse limite du volant (traînée quadratique)
  const FLIP_K = 25;          // raideur du retournement bouchon en avant
  const SHUTTLE_SCALE = 1.3;  // agrandissement du volant pour la lisibilité
  const ORBIT_INERTIA = 0.93; // inertie de l'orbite (par image à 60 fps)
  const TRAIL_POINTS = 90;    // longueur de la traînée lumineuse
  const FLICK_SPEED = 1.0;    // px/ms : au-delà, un geste court déclenche un swing
  const FOLLOW_LOOK = 0.6;    // part du chemin raquette -> volant vers laquelle la caméra regarde après la frappe
  const FOLLOW_ZOOM = 0.3;    // recul relatif de la caméra pendant le suivi

  // ───────── constantes dérivées et géométrie (m) ─────────
  // Repère raquette : bas du manche en y = 0, cordage dans le plan z = 0, normale +z (sens du swing).
  const H = 1 / 4000;                       // pas fixe de la simulation
  const G = 9.81, K_DRAG = G / (V_TERM * V_TERM);
  const HEAD_CY = 0.555, HEAD_A = 0.1, HEAD_B = 0.125, EGG = 0.1;
  const HEAD_TOP = HEAD_CY + HEAD_B, HEAD_BOT = HEAD_CY - HEAD_B;
  const INSET = 0.006, IA = HEAD_A - INSET, IB = HEAD_B - INSET;
  const PIVOT_DROP = 0.05, FLOOR = -1.02, NET_Z = 2.4, SPINK = 10;
  const Y0 = 0.205;                         // encastrement : haut du manche
  const LB = HEAD_BOT - Y0;                 // longueur de tige libre (poutre)
  const HEAD_K = 1 + (1.5 * (HEAD_CY - HEAD_BOT)) / LB;   // δ au centre de la tête = δ_tige × HEAD_K (tête rigide)

  const root = document.querySelector<HTMLElement>('[data-hero="racket"]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>(':scope > canvas')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = Math.min(innerWidth, innerHeight) < 700;
    const fr = () => document.documentElement.dataset.lang !== 'en';

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: 'high-performance' });
      if (!renderer.getContext()) throw new Error('webgl');
    } catch (e) { root.classList.add('nogl'); return; }
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(0x120f1a, 3.2, 15);
    scene.background = (() => {
      const c = document.createElement('canvas'); c.width = 512; c.height = 512; const x = c.getContext('2d')!;
      const g = x.createRadialGradient(266, 200, 0, 256, 220, 380);
      g.addColorStop(0, '#231b38'); g.addColorStop(0.45, '#15121e'); g.addColorStop(1, '#0d0c12');
      x.fillStyle = g; x.fillRect(0, 0, 512, 512);
      const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; return t;
    })();
    const pmrem = new THREE.PMREMGenerator(renderer);
    scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
    scene.environmentIntensity = 0.55;
    const camera = new THREE.PerspectiveCamera(34, 1, 0.02, 80);

    // ───────── lumières ─────────
    scene.add(new THREE.HemisphereLight(0xc9b8ff, 0x0f0e14, 0.5));
    const key = new THREE.DirectionalLight(0xfff4fb, 2.2); key.position.set(1.5, 3, -2.2); scene.add(key);
    const rimPink = new THREE.DirectionalLight(0xffa8cf, 2.4); rimPink.position.set(-2.5, 1.2, 2.5); scene.add(rimPink);
    const rimCyan = new THREE.DirectionalLight(0x7fe6ff, 1.4); rimCyan.position.set(2.8, 0.4, 2.2); scene.add(rimCyan);
    const fill = new THREE.PointLight(0x8f7bff, 1.2, 4, 1.5); fill.position.set(-0.6, 0.5, -0.8); scene.add(fill);

    // ───────── flexion de la tige (injectée dans les shaders) ─────────
    // Profil de poutre encastrée chargée en bout : w(u) = δ u² (3 - u) / 2 sur la tige, puis tête rigide (rotation de pente 3δ / 2L).
    const U = { uDef: { value: 0 } };
    const f = (n: number) => n.toFixed(5);
    const deform = (mat: THREE.Material, keyName: string) => {
      mat.onBeforeCompile = (sh) => {
        Object.assign(sh.uniforms, U);
        sh.vertexShader = sh.vertexShader
          .replace('#include <common>', `#include <common>
            uniform float uDef;`)
          .replace('#include <begin_vertex>', `#include <begin_vertex>
            {
              float y = transformed.y;
              float u = clamp((y - ${f(Y0)}) / ${f(LB)}, 0., 1.);
              float w = y <= ${f(HEAD_BOT)} ? uDef * u * u * (3. - u) * .5 : uDef * (1. + 1.5 * (y - ${f(HEAD_BOT)}) / ${f(LB)});
              transformed.z -= w;
            }`);
      };
      mat.customProgramCacheKey = () => keyName;
    };

    // ───────── matériaux ─────────
    const pearl = new THREE.MeshPhysicalMaterial({
      color: 0xebe4ff, metalness: 0.25, roughness: 0.24, clearcoat: 1, clearcoatRoughness: 0.06,
      iridescence: 0.9, iridescenceIOR: 1.38, iridescenceThicknessRange: [200, 520], fog: false,
    });
    const lavender = new THREE.MeshPhysicalMaterial({ color: 0xb9a6ff, metalness: 0.55, roughness: 0.28, clearcoat: 1, clearcoatRoughness: 0.1, fog: false });
    const pink = new THREE.MeshPhysicalMaterial({ color: 0xffa8cf, metalness: 0.2, roughness: 0.35, clearcoat: 0.8, emissive: 0x3a1024, emissiveIntensity: 0.4, fog: false });
    // tige : légère lueur qui s'intensifie avec la flexion
    const shaftMat = new THREE.MeshPhysicalMaterial({ color: 0xf0e8ff, metalness: 0.3, roughness: 0.22, clearcoat: 1, emissive: 0xff7fb8, emissiveIntensity: 0, fog: false });
    const gripMat = new THREE.MeshStandardMaterial({ color: 0xf4c7dc, roughness: 0.82, metalness: 0, fog: false });
    const gripCore = new THREE.MeshStandardMaterial({ color: 0xb98aa8, roughness: 0.8, metalness: 0, fog: false });
    const stringMat = new THREE.LineBasicMaterial({ color: 0xf6f1ff, transparent: true, opacity: 0.8, fog: false });
    const massMat = new THREE.MeshPhysicalMaterial({ color: 0x9d8cff, metalness: 0.7, roughness: 0.25, clearcoat: 1, fog: false });
    const ghostMat = new THREE.LineBasicMaterial({ color: 0xc9b8ff, transparent: true, opacity: 0, depthWrite: false, fog: false });
    [pearl, lavender, pink, shaftMat, gripMat, gripCore, stringMat, massMat].forEach((m, i) => deform(m, 'rk-def-' + i));

    // ───────── raquette procédurale ─────────
    const swing = new THREE.Group();        // axe vertical de l'épaule, en x = ARM : rotation du swing
    const holder = new THREE.Group();       // la main
    const racket = new THREE.Group();       // repère raquette
    swing.position.x = ARM; holder.position.x = -ARM; racket.position.y = PIVOT_DROP;
    swing.add(holder); holder.add(racket); scene.add(swing);

    const seg = mobile ? 0.6 : 1;
    const eggPoint = (t: number, a = HEAD_A, b = HEAD_B, z = 0) =>
      new THREE.Vector3(a * Math.cos(t) * (1 + EGG * Math.sin(t)), HEAD_CY + b * Math.sin(t), z);
    const halfWidth = (y: number, a: number, b: number) => {
      const s = (y - HEAD_CY) / b; if (Math.abs(s) >= 1) return 0;
      return a * Math.sqrt(1 - s * s) * (1 + EGG * s);
    };
    class EggCurve extends THREE.Curve<THREE.Vector3> {
      constructor(private a: number, private b: number, private z: number, private t0 = -Math.PI / 2, private t1 = Math.PI * 1.5) { super(); }
      getPoint(u: number, target = new THREE.Vector3()) { return target.copy(eggPoint(this.t0 + (this.t1 - this.t0) * u, this.a, this.b, this.z)); }
    }
    const add = (g: THREE.BufferGeometry, m: THREE.Material) => { const o = new THREE.Mesh(g, m); racket.add(o); return o; };
    const frameGeo = new THREE.TubeGeometry(new EggCurve(HEAD_A, HEAD_B, 0), Math.round(220 * seg), 0.0052, 14, true);
    frameGeo.scale(1, 1, 1.45);
    add(frameGeo, pearl);
    for (const z of [0.0068, -0.0068]) add(new THREE.TubeGeometry(new EggCurve(HEAD_A, HEAD_B, z, 0.12 * Math.PI, 0.88 * Math.PI), 90, 0.0012, 6, false), pink);
    add(new THREE.TubeGeometry(new EggCurve(HEAD_A + 0.0049, HEAD_B + 0.0049, 0, -0.38 * Math.PI, 1.38 * Math.PI), 160, 0.0015, 6, false), lavender);
    const tBar = new THREE.CapsuleGeometry(0.0046, 0.034, 4, 12); tBar.rotateZ(Math.PI / 2); tBar.translate(0, HEAD_BOT - 0.004, 0); add(tBar, lavender);
    const throat = new THREE.CylinderGeometry(0.0062, 0.0039, 0.03, 16); throat.translate(0, HEAD_BOT - 0.019, 0); add(throat, pearl);
    const tRing = new THREE.TorusGeometry(0.0046, 0.0011, 8, 24); tRing.rotateX(Math.PI / 2); tRing.translate(0, HEAD_BOT - 0.031, 0); add(tRing, pink);
    // tige fine, très subdivisée en hauteur pour pouvoir se courber
    const shaftLen = HEAD_BOT - 0.034 - 0.222;
    const shaft = new THREE.CylinderGeometry(0.0037, 0.0042, shaftLen, 14, 48); shaft.translate(0, (HEAD_BOT - 0.034 + 0.222) / 2, 0); add(shaft, shaftMat);
    const cone = new THREE.CylinderGeometry(0.0044, 0.0118, 0.032, 18); cone.translate(0, 0.206, 0); add(cone, lavender);
    const handle = new THREE.CylinderGeometry(0.0118, 0.0124, 0.19, 8); handle.translate(0, 0.095, 0); add(handle, gripCore);
    const helixPts: THREE.Vector3[] = [];
    const TURNS = 19, HY0 = 0.014, HY1 = 0.186;
    for (let i = 0; i <= TURNS * 40; i++) {
      const u = i / (TURNS * 40), a = u * TURNS * Math.PI * 2;
      helixPts.push(new THREE.Vector3(Math.cos(a) * 0.0108, HY0 + (HY1 - HY0) * u, Math.sin(a) * 0.0108));
    }
    add(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(helixPts), Math.round(TURNS * 40 * seg), 0.0042, 8, false), gripMat);
    const cap = new THREE.CylinderGeometry(0.0134, 0.013, 0.011, 24); cap.translate(0, 0.0055, 0); add(cap, pearl);
    const capRing = new THREE.TorusGeometry(0.0132, 0.0011, 8, 32); capRing.rotateX(Math.PI / 2); capRing.translate(0, 0.0115, 0); add(capRing, pink);
    const topRing = new THREE.TorusGeometry(0.0125, 0.0012, 8, 32); topRing.rotateX(Math.PI / 2); topRing.translate(0, 0.19, 0); add(topRing, lavender);
    // masses ajoutées en haut de la tête (aimants du TIPE), visibles selon le réglage
    const masses = [-1, 0, 1].map((k) => {
      const g = new THREE.CylinderGeometry(0.011, 0.011, 0.012, 20); g.rotateX(Math.PI / 2);
      g.translate(k * 0.026, HEAD_TOP - 0.006 - Math.abs(k) * 0.008, 0);
      const o = add(g, massMat); o.visible = false; return o;
    });

    // cordage
    const STEP = 0.0082, SUB = 6;
    const sv: number[] = [];
    const seg2 = (x0: number, y0: number, x1: number, y1: number, z: number) => {
      for (let i = 0; i < SUB; i++) {
        const a = i / SUB, b = (i + 1) / SUB;
        sv.push(x0 + (x1 - x0) * a, y0 + (y1 - y0) * a, z, x0 + (x1 - x0) * b, y0 + (y1 - y0) * b, z);
      }
    };
    for (let y = HEAD_CY - Math.floor(IB / STEP) * STEP; y < HEAD_CY + IB; y += STEP) {
      const w = halfWidth(y, IA, IB); if (w > 0.004) seg2(-w, y, w, y, -0.0004);
    }
    for (let x = -Math.floor(IA * 1.1 / STEP) * STEP; x < IA * 1.1; x += STEP) {
      let lo = Infinity, hi = -Infinity;
      for (let k = 0; k <= 600; k++) { const y = HEAD_CY - IB + (2 * IB * k) / 600; if (halfWidth(y, IA, IB) >= Math.abs(x)) { lo = Math.min(lo, y); hi = Math.max(hi, y); } }
      if (hi - lo > 0.006) seg2(x, lo, x, hi, 0.0004);
    }
    const strGeo = new THREE.BufferGeometry(); strGeo.setAttribute('position', new THREE.Float32BufferAttribute(sv, 3));
    racket.add(new THREE.LineSegments(strGeo, stringMat));

    // fantôme : la raquette rigide (sans flexion), en fil discret, pour lire la déflexion
    const ghostPts: number[] = [];
    for (let i = 0; i < 96; i++) { const a = eggPoint(-Math.PI / 2 + (i / 96) * Math.PI * 2), b = eggPoint(-Math.PI / 2 + ((i + 1) / 96) * Math.PI * 2); ghostPts.push(a.x, a.y, 0, b.x, b.y, 0); }
    ghostPts.push(0, Y0, 0, 0, HEAD_BOT, 0);
    racket.add(new THREE.LineSegments(new THREE.BufferGeometry().setAttribute('position', new THREE.Float32BufferAttribute(ghostPts, 3)), ghostMat));

    // ───────── textures procédurales ─────────
    const glowTex = (() => {
      const c = document.createElement('canvas'); c.width = c.height = 128; const x = c.getContext('2d')!;
      const g = x.createRadialGradient(64, 64, 0, 64, 64, 64);
      g.addColorStop(0, 'rgba(255,255,255,1)'); g.addColorStop(0.2, 'rgba(255,255,255,.55)'); g.addColorStop(1, 'rgba(255,255,255,0)');
      x.fillStyle = g; x.fillRect(0, 0, 128, 128); const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; return t;
    })();
    const featherTex = (() => {
      const W = 512, Hh = 160, N = 16, c = document.createElement('canvas'); c.width = W; c.height = Hh; const x = c.getContext('2d')!;
      x.fillStyle = '#000'; x.fillRect(0, 0, W, Hh);
      for (let i = 0; i < N; i++) {
        const cx = (i + 0.5) * W / N, hw = W / N * 0.62;
        x.fillStyle = '#fff'; x.beginPath();
        x.moveTo(cx - hw * 0.5, 0); x.lineTo(cx + hw * 0.5, 0); x.lineTo(cx + hw, Hh - hw * 1.1);
        x.quadraticCurveTo(cx + hw, Hh - 2, cx, Hh - 2); x.quadraticCurveTo(cx - hw, Hh - 2, cx - hw, Hh - hw * 1.1); x.closePath(); x.fill();
      }
      x.fillStyle = '#fff'; x.fillRect(0, 0, W, Hh * 0.18);
      const t = new THREE.CanvasTexture(c); t.wrapS = THREE.RepeatWrapping; return t;
    })();

    // ───────── volant (posé sur la trajectoire de la tête) ─────────
    const shuttle = new THREE.Group(); shuttle.scale.setScalar(SHUTTLE_SCALE); scene.add(shuttle);
    shuttle.add(new THREE.Mesh(new THREE.SphereGeometry(0.0125, 20, 12, 0, Math.PI * 2, 0, Math.PI / 2), new THREE.MeshStandardMaterial({ color: 0xfff7fb, roughness: 0.55, fog: false })));
    const corkBase = new THREE.Mesh(new THREE.CylinderGeometry(0.0125, 0.012, 0.013, 20), new THREE.MeshStandardMaterial({ color: 0xffa8cf, roughness: 0.5, fog: false }));
    corkBase.position.y = -0.0065; shuttle.add(corkBase);
    const skirtGeo = new THREE.CylinderGeometry(0.0115, 0.033, 0.07, 32, 1, true); skirtGeo.translate(0, -0.013 - 0.035, 0);
    shuttle.add(new THREE.Mesh(skirtGeo, new THREE.MeshStandardMaterial({
      color: 0xfbf8ff, roughness: 0.75, alphaMap: featherTex, transparent: true, alphaTest: 0.3, side: THREE.DoubleSide,
      emissive: 0x2b2340, emissiveIntensity: 0.6, fog: false,
    })));
    const band = new THREE.Mesh(new THREE.TorusGeometry(0.0165, 0.0008, 6, 32), new THREE.MeshBasicMaterial({ color: 0xc9b8ff, fog: false }));
    band.rotation.x = Math.PI / 2; band.position.y = -0.031; shuttle.add(band);
    const halo = new THREE.Sprite(new THREE.SpriteMaterial({ map: glowTex, color: 0xffd6ea, transparent: true, opacity: 0.35, blending: THREE.AdditiveBlending, depthWrite: false, fog: false }));
    halo.scale.setScalar(0.09); shuttle.add(halo);

    // ───────── traînée lumineuse du volant (ruban face caméra) ─────────
    const trailPos = new Float32Array(TRAIL_POINTS * 2 * 3), trailCol = new Float32Array(TRAIL_POINTS * 2 * 3);
    const trailIdx: number[] = [];
    for (let i = 0; i < TRAIL_POINTS - 1; i++) { const a = i * 2; trailIdx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2); }
    const trailGeo = new THREE.BufferGeometry();
    trailGeo.setAttribute('position', new THREE.BufferAttribute(trailPos, 3).setUsage(THREE.DynamicDrawUsage));
    trailGeo.setAttribute('color', new THREE.BufferAttribute(trailCol, 3).setUsage(THREE.DynamicDrawUsage));
    trailGeo.setIndex(trailIdx);
    const trailMesh = new THREE.Mesh(trailGeo, new THREE.MeshBasicMaterial({ vertexColors: true, transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide, fog: false }));
    trailMesh.frustumCulled = false; scene.add(trailMesh);
    const trail: { p: THREE.Vector3; t: number }[] = [];
    // arc lumineux laissé par le centre de la tête pendant le swing
    const HEAD_TRAIL = 80, htPos = new Float32Array(HEAD_TRAIL * 3), htCol = new Float32Array(HEAD_TRAIL * 3);
    const htGeo = new THREE.BufferGeometry();
    htGeo.setAttribute('position', new THREE.BufferAttribute(htPos, 3).setUsage(THREE.DynamicDrawUsage));
    htGeo.setAttribute('color', new THREE.BufferAttribute(htCol, 3).setUsage(THREE.DynamicDrawUsage));
    const headTrail = new THREE.Line(htGeo, new THREE.LineBasicMaterial({ vertexColors: true, transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, fog: false }));
    headTrail.frustumCulled = false; scene.add(headTrail);
    const htPts: { p: THREE.Vector3; t: number }[] = [];

    const flash = new THREE.Sprite(new THREE.SpriteMaterial({ map: glowTex, color: 0xffc2de, transparent: true, opacity: 0, blending: THREE.AdditiveBlending, depthWrite: false, fog: false }));
    scene.add(flash);
    let flashT = -1e9;

    // ───────── décor : terrain, filet, poussière ─────────
    const lineMat = new THREE.LineBasicMaterial({ color: 0xc9b8ff, transparent: true, opacity: 0.22 });
    const court: number[] = [];
    const Lc = (x0: number, z0: number, x1: number, z1: number) => court.push(x0, FLOOR, z0, x1, FLOOR, z1);
    const Z0 = NET_Z - 6.7, Z1 = NET_Z + 6.7;
    for (const x of [-3.05, -2.59, 2.59, 3.05]) Lc(x, Z0, x, Z1);
    for (const z of [Z0, Z0 + 0.76, NET_Z - 1.98, NET_Z + 1.98, Z1 - 0.76, Z1]) Lc(-3.05, z, 3.05, z);
    Lc(0, Z0, 0, NET_Z - 1.98); Lc(0, NET_Z + 1.98, 0, Z1);
    scene.add(new THREE.LineSegments(new THREE.BufferGeometry().setAttribute('position', new THREE.Float32BufferAttribute(court, 3)), lineMat));
    const net: number[] = [], NH = 0.76, NTOP = FLOOR + 1.55;
    for (let x = -3.05; x <= 3.051; x += 0.09) net.push(x, NTOP - NH, NET_Z, x, NTOP, NET_Z);
    for (let y = NTOP - NH; y <= NTOP + 0.001; y += 0.09) net.push(-3.05, y, NET_Z, 3.05, y, NET_Z);
    scene.add(new THREE.LineSegments(new THREE.BufferGeometry().setAttribute('position', new THREE.Float32BufferAttribute(net, 3)), new THREE.LineBasicMaterial({ color: 0x9d8cff, transparent: true, opacity: 0.07 })));
    const tape = new THREE.Mesh(new THREE.BoxGeometry(6.1, 0.03, 0.006), new THREE.MeshBasicMaterial({ color: 0xe9e2ff, transparent: true, opacity: 0.22 }));
    tape.position.set(0, NTOP, NET_Z); scene.add(tape);
    for (const x of [-3.05, 3.05]) { const p = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.018, 1.55, 8), new THREE.MeshBasicMaterial({ color: 0x8c7bd6, transparent: true, opacity: 0.35 })); p.position.set(x, FLOOR + 0.775, NET_Z); scene.add(p); }
    const pool = new THREE.Mesh(new THREE.PlaneGeometry(3.2, 3.2), new THREE.MeshBasicMaterial({ map: glowTex, color: 0x5b4aa8, transparent: true, opacity: 0.45, blending: THREE.AdditiveBlending, depthWrite: false }));
    pool.rotation.x = -Math.PI / 2; pool.position.set(0, FLOOR + 0.002, 0.2); scene.add(pool);
    const DUST = mobile ? 110 : 240, dustPos = new Float32Array(DUST * 3), dustSeed = new Float32Array(DUST);
    for (let i = 0; i < DUST; i++) { dustPos[i * 3] = (Math.random() - 0.5) * 6; dustPos[i * 3 + 1] = FLOOR + Math.random() * 3; dustPos[i * 3 + 2] = (Math.random() - 0.4) * 8; dustSeed[i] = Math.random() * 100; }
    const dustGeo = new THREE.BufferGeometry(); dustGeo.setAttribute('position', new THREE.BufferAttribute(dustPos, 3).setUsage(THREE.DynamicDrawUsage));
    scene.add(new THREE.Points(dustGeo, new THREE.PointsMaterial({ color: 0xc9b8ff, size: 0.012, map: glowTex, transparent: true, opacity: 0.55, blending: THREE.AdditiveBlending, depthWrite: false })));

    // ───────── paramètres choisis et grandeurs du modèle ─────────
    const cfg = { rk: RACKETS.perfly, add: 0, tau: TAU_DEFAULT };
    const model = () => {
      const k = 1 / (cfg.rk.Kexp * 1e-3);                 // N/m, raideur équivalente k = 1/K = 3EI/L³
      const m = M_EQ * cfg.rk.M + cfg.add / 1000;         // kg
      const w0 = Math.sqrt(k / m), w = Math.PI / cfg.tau;
      return { k, m, w0, w, wt: w / w0 };
    };

    // ───────── simulation : manche imposé, tête = masse sur ressort ─────────
    // ẍ_T = ω₀² (x_M - x_T) + 2ζω₀ (ẋ_M - ẋ_T) ; δ = x_M - x_T
    let simT = 0, acc = 0, timeScale = 1, slowTs = 0.05;
    type Mode = 'idle' | 'windup' | 'hold' | 'swing' | 'follow' | 'recover';
    const st = {
      mode: 'idle' as Mode, t0: 0, tS: 0, xM: 0, vM: 0, xT: 0, vT: 0, from: 0, p: model(),
      maxVM: 0, maxVT: 0, maxD: 0, hit: false, vShuttle: 0, span: 1, whip: false, done: false,

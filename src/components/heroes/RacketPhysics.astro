      st.maxVM = st.maxVT = st.maxD = 0; st.hit = false; st.whip = false; st.done = false; st.vShuttle = 0;
      // fenêtre montrée au ralenti : le swing, puis environ 2,5 périodes d'oscillation libre de la tige

      if (st.mode === 'hold' && simT - st.t0 >= 0.12) startSwing();
      if (st.mode === 'swing' && simT - st.tS >= cfg.tau) st.mode = 'follow';
      if (st.mode === 'follow' && simT - st.tS >= st.span + 0.35) { st.mode = 'recover'; st.t0 = simT; }
      if (st.mode === 'recover' && simT - st.t0 >= 0.75) { st.mode = 'idle'; resetShuttle(); }
      const hM = handleAt(simT), p = st.p;
      const prevXT = st.xT;
      const aT = p.w0 * p.w0 * (hM.x - st.xT) + 2 * ZETA * p.w0 * (hM.v - st.vT);
      st.vT += aT * H; st.xT += st.vT * H; st.xM = hM.x; st.vM = hM.v;
      if (st.mode === 'swing' || st.mode === 'follow') {
        const s = simT - st.tS;
        if (s <= 1.5 * cfg.tau) { st.maxVM = Math.max(st.maxVM, st.vM); st.maxVT = Math.max(st.maxVT, st.vT); }
        else if (!st.done) { st.done = true; showResult(); }
        st.maxD = Math.max(st.maxD, Math.abs(st.xM - st.xT));

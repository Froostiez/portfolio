  .cue.hot .cue-txt { color: #ffa8cf; text-shadow: 0 0 18px rgba(255, 168, 207, .55); }
  .cue.calm .cue-txt { color: rgba(201, 184, 255, .85); }

  .panel {
    position: absolute; left: 50px; bottom: 50px; width: 440px; padding: 12px 14px 12px; border-radius: 14px; pointer-events: auto; cursor: auto;
    background: rgba(18, 15, 28, .56); border: 1px solid rgba(201, 184, 255, .14);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    max-height: calc(100% - 240px); overflow-y: auto; scrollbar-width: thin;   /* ne remonte jamais sur les équations */
  }

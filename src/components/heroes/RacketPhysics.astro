      const vmax = Math.max(0.1, A_SWING * st.p.w * 1.85), dmax = A_SWING * 1.8;
      sctx.fillStyle = 'rgba(201,184,255,.3)'; sctx.beginPath(); sctx.moveTo(X(samples[0].t), dTop);
      for (const s of samples) sctx.lineTo(X(s.t), dTop + Math.min(1, Math.abs(s.d) / dmax) * (Hh - dTop - 1 * dpr));
      sctx.lineTo(X(samples[samples.length - 1].t), dTop); sctx.closePath(); sctx.fill();
      const line = (k: 'vM' | 'vT', col: string) => {
        sctx.lineWidth = 1.6 * dpr; sctx.strokeStyle = col; sctx.shadowColor = col; sctx.shadowBlur = 5 * dpr; sctx.beginPath();
        samples.forEach((s, i) => { const x = X(s.t), y = base - Math.max(-0.15, s[k] / vmax) * (base - 3 * dpr); i ? sctx.lineTo(x, y) : sctx.moveTo(x, y); });
        sctx.stroke(); sctx.shadowBlur = 0;
      };
      line('vM', '#ffa8cf'); line('vT', '#8fd8ff');
    };
    // courbe du gain v_T / v_M en fonction de ω̃ (même protocole que la simulation)
    const gainCurve: { wt: number; r: number }[] = [];
    for (let i = 0; i <= 70; i++) {
      const wt = Math.pow(10, -1.3 + (2.3 * i) / 70), w0 = 1 / wt, dt = 0.004 * Math.min(1, wt);
      let x = -1, v = 0, mx = 0;
      for (let t = 0; t < 1.5 * Math.PI; t += dt) {
        const xm = t < Math.PI ? -Math.cos(t) : 1, vm = t < Math.PI ? Math.sin(t) : 0;
        v += (w0 * w0 * (xm - x) + 2 * ZETA * w0 * (vm - v)) * dt; x += v * dt; mx = Math.max(mx, v);
      }
      gainCurve.push({ wt, r: mx });
    }
    const gainAt = (wt: number) => { let r = gainCurve[0].r; for (const g of gainCurve) if (g.wt <= wt) r = g.r; return r; };
    const gainC = q('[data-gain]') as HTMLCanvasElement, gctx = gainC.getContext('2d')!;
    function drawGain() {
      const { dpr, W, Hh } = fit(gainC); if (!W || !Hh) return;
      gctx.clearRect(0, 0, W, Hh);
      const X = (wt: number) => ((Math.log10(wt) + 1.3) / 2.3) * W, Y = (r: number) => Hh - 3 * dpr - (r / 2) * (Hh - 8 * dpr);
      gctx.lineWidth = 1; gctx.strokeStyle = 'rgba(201,184,255,.12)'; gctx.beginPath();
      for (const d of [0.1, 1, 10]) { const x = Math.round(X(d)) + 0.5; gctx.moveTo(x, 0); gctx.lineTo(x, Hh); }
      gctx.stroke();
      gctx.setLineDash([3 * dpr, 3 * dpr]); gctx.strokeStyle = 'rgba(201,184,255,.35)'; gctx.beginPath(); gctx.moveTo(0, Math.round(Y(1)) + 0.5); gctx.lineTo(W, Math.round(Y(1)) + 0.5); gctx.stroke(); gctx.setLineDash([]);
      // mesures du TIPE pour la configuration courante : bande rose sur le bord gauche
      const m = meas();
      if (m) { gctx.fillStyle = 'rgba(255,168,207,.55)'; gctx.fillRect(0, Y(m.hi), 3 * dpr, Math.max(2 * dpr, Y(m.lo) - Y(m.hi))); }
      gctx.lineWidth = 1.5 * dpr; gctx.strokeStyle = '#c9b8ff'; gctx.beginPath();
      gainCurve.forEach((g, i) => { const x = X(g.wt), y = Y(g.r); i ? gctx.lineTo(x, y) : gctx.moveTo(x, y); }); gctx.stroke();
      gctx.fillStyle = 'rgba(169,163,184,.9)'; gctx.font = `${8.5 * dpr}px ui-monospace, Menlo, Consolas, monospace`;
      gctx.fillText(document.documentElement.dataset.lang === 'en' ? '1.77' : '1,77', X(STUDY_WT) - 9 * dpr, Y(STUDY_PEAK) - 4 * dpr);
      gctx.fillText('1', W - 8 * dpr, Y(1) - 3 * dpr);
      const wt = Math.min(10, Math.max(0.05, model().wt));
      gctx.fillStyle = '#ffa8cf'; gctx.shadowColor = '#ffa8cf'; gctx.shadowBlur = 6 * dpr;
      gctx.beginPath(); gctx.arc(X(wt), Y(gainAt(wt)), 3.2 * dpr, 0, Math.PI * 2); gctx.fill(); gctx.shadowBlur = 0;
    }
    new MutationObserver(() => drawGain()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });

    // encart d'explication
    const introEl = q('[data-intro]'), helpEl = q('[data-help]');
    let introOpen = true;
    const setIntro = (open: boolean, focus = true) => {
      introOpen = open;
      introEl?.classList.toggle('closed', !open); introEl?.setAttribute('aria-hidden', String(!open));
      helpEl?.classList.toggle('hide', open); helpEl?.setAttribute('aria-expanded', String(open));
      if (open && focus) (introEl?.querySelector('[data-ok]') as HTMLElement | null)?.focus({ preventScroll: true });
    };
    setIntro(true, false);
    q('[data-close]')?.addEventListener('click', () => setIntro(false));
    q('[data-ok]')?.addEventListener('click', () => setIntro(false));
    helpEl?.addEventListener('click', () => setIntro(true));
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && introOpen) setIntro(false); });
    // repère d'action
    const cueEl = q('[data-cue]'), cueTxt = q('[data-cuetxt]');
    const touch = matchMedia('(pointer: coarse)').matches;
    let cueKey = '';
    const setCue = (key: string, cls: string, a = '', b = '') => {
      if (!cueEl || !cueTxt || key === cueKey) return;
      cueKey = key; cueEl.className = 'cue' + (key ? ' on ' + cls : '');
      if (a) cueTxt.innerHTML = bi(a, b);
    };

    // ───────── caméra : orbite douce avec inertie ─────────
    const base = new THREE.Vector3(0, 0.47, 0.05), camTarget = new THREE.Vector3();
    const follow = { w: 0, off: new THREE.Vector3(), want: new THREE.Vector3() };
    const orbit = { az: Math.PI + 1.12, el: 0.16, vaz: 0, vel: 0 };
    const placeCamera = () => {
      const aspect = canvas.clientWidth / Math.max(1, canvas.clientHeight);
      const dist = 1.9 * (aspect < 1 ? 1 + (1 - aspect) * 1.6 : 1) * (1 + FOLLOW_ZOOM * follow.w);
      const k = 0.16 * Math.min(1, Math.max(0, (aspect - 0.8) / 0.6));
      camTarget.set(base.x - Math.cos(orbit.az) * k, base.y - (aspect < 1 ? 0.2 : 0), base.z + Math.sin(orbit.az) * k);
      camera.position.set(
        camTarget.x + dist * Math.sin(orbit.az) * Math.cos(orbit.el),
        camTarget.y + dist * Math.sin(orbit.el),
        camTarget.z + dist * Math.cos(orbit.az) * Math.cos(orbit.el),
      );
      camera.lookAt(camTarget.addScaledVector(follow.off, FOLLOW_LOOK * follow.w * (aspect < 1 ? 0.6 : 1)));
    };
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, mobile ? 1.5 : 2);
      const w = canvas.clientWidth, h = canvas.clientHeight;
      if (!w || !h) return false;
      renderer.setPixelRatio(dpr); renderer.setSize(w, h, false);
      camera.aspect = w / h; camera.updateProjectionMatrix();
      return true;
    };

    // ───────── rendu d'une image ─────────
    const qSpin = new THREE.Quaternion(), Yv = new THREE.Vector3(0, 1, 0), camTmp = new THREE.Vector3(), headW = new THREE.Vector3();
    const syncScene = (now: number) => {
      swing.rotation.y = st.xM / ARM;
      const d = st.xM - st.xT, vis = VIS_MAX * Math.tanh(d / VIS_MAX);
      U.uDef.value = vis / HEAD_K;
      shaftMat.emissiveIntensity = Math.min(1.4, Math.abs(d) / 0.06);
      ghostMat.opacity = Math.min(0.45, Math.abs(d) / 0.03);
      racket.updateWorldMatrix(true, false);
      headW.set(0, HEAD_CY, -vis); racket.localToWorld(headW);
      const swinging = st.mode === 'swing' || st.mode === 'follow';
      if (swinging) { const l = htPts[htPts.length - 1]; if (!l || l.p.distanceToSquared(headW) > 1e-5) { htPts.push({ p: headW.clone(), t: now }); if (htPts.length > HEAD_TRAIL) htPts.shift(); } }
      const hn = htPts.length;
      for (let i = 0; i < HEAD_TRAIL; i++) {
        const o = i * 3, pt = htPts[Math.min(i, hn - 1)];
        if (!pt) { htPos[o] = htPos[o + 1] = htPos[o + 2] = 0; htCol[o] = htCol[o + 1] = htCol[o + 2] = 0; continue; }
        htPos[o] = pt.p.x; htPos[o + 1] = pt.p.y; htPos[o + 2] = pt.p.z;
        const al = i < hn ? (reduced ? 0.8 : Math.exp(-(now - pt.t) / 2.5)) * ((i + 1) / hn) : 0;
        htCol[o] = 0.56 * al; htCol[o + 1] = 0.85 * al; htCol[o + 2] = 1 * al;
      }
      htGeo.attributes.position.needsUpdate = true; htGeo.attributes.color.needsUpdate = true;
      if (shuttle.visible) {
        shuttle.position.copy(sh.p);
        shuttle.quaternion.setFromUnitVectors(Yv, sh.axis).multiply(qSpin.setFromAxisAngle(Yv, sh.spin));
        halo.scale.setScalar(Math.max(0.09, camera.position.distanceTo(sh.p) * 0.03));
        halo.material.opacity = shPhase === 'tee' && !reduced ? 0.42 + 0.12 * Math.sin(now * 4) : 0.35;
      }
      camTmp.copy(camera.position);
      const n = trail.length;
      for (let i = 0; i < TRAIL_POINTS; i++) {
        const j = Math.min(i, n - 1), o = i * 6;
        if (n < 2 || i >= n) { for (let k = 0; k < 6; k++) { trailPos[o + k] = n ? trail[n - 1].p.getComponent(k % 3) : 0; trailCol[o + k] = 0; } continue; }
        const p = trail[j].p, pa = trail[Math.max(0, j - 1)].p, pb = trail[Math.min(n - 1, j + 1)].p;
        tmpA.subVectors(pb, pa); tmpB.subVectors(camTmp, p); tmpA.cross(tmpB).normalize();
        const u = (j + 1) / n, wdt = 0.0048 * Math.pow(u, 1.5) * SHUTTLE_SCALE;
        const al = u * u * (reduced ? 1 : Math.exp(-(now - trail[j].t) / 2));
        trailPos[o] = p.x + tmpA.x * wdt; trailPos[o + 1] = p.y + tmpA.y * wdt; trailPos[o + 2] = p.z + tmpA.z * wdt;
        trailPos[o + 3] = p.x - tmpA.x * wdt; trailPos[o + 4] = p.y - tmpA.y * wdt; trailPos[o + 5] = p.z - tmpA.z * wdt;
        for (let k = 0; k < 2; k++) { trailCol[o + k * 3] = 0.85 * al; trailCol[o + k * 3 + 1] = 0.42 * al; trailCol[o + k * 3 + 2] = 0.62 * al; }
      }
      trailGeo.attributes.position.needsUpdate = true; trailGeo.attributes.color.needsUpdate = true;
      const fa = now - flashT;
      flash.material.opacity = Math.max(0, 1 - fa / 0.9) * 0.9;
      flash.scale.setScalar(0.08 + Math.min(1, fa / 0.9) * 0.22);
    };
    const render = () => { placeCamera(); renderer.render(scene, camera); };

    resize(); placeCamera(); resetShuttle(); refreshParams();
    (window as any).__rk = { st, cfg, model, get simT() { return simT; }, get ts() { return timeScale; }, get shPhase() { return shPhase; }, sh, camera };   // DEBUG

    // ───────── image fixe (prefers-reduced-motion) ─────────
    // on joue un swing complet sans l'afficher, puis on fige la scène à la déflexion maximale
    if (reduced) {
      still = () => {
        st.mode = 'idle'; st.xM = st.xT = st.vT = 0; simT = 0; resetShuttle();
        swingNow(); for (let i = 0; i < 40000 && st.mode !== 'swing'; i++) physStep();
        let best = -1, keep = { xM: 0, xT: 0 }, k = 0;
        while ((st.mode === 'swing' || st.mode === 'follow') && simT - st.tS < st.span && k++ < 400000) {
          physStep(); if (shPhase === 'out') flyStep(H);
          if (k % 8 === 0) samples.push({ t: simT, vM: st.vM, vT: st.vT, d: st.xM - st.xT });
          const d = Math.abs(st.xM - st.xT);
          if (d > best && simT - st.tS < cfg.tau) { best = d; keep = { xM: st.xM, xT: st.xT }; }
        }
        if (!st.done) showResult();
        st.xM = keep.xM; st.xT = keep.xT; resetShuttle(); shuttle.visible = false; htPts.length = 0; flashT = -1e9;   // image centrée sur la tige courbée
        resize(); syncScene(performance.now() / 1000); render(); drawScope(); drawGain();
        if (cueEl) cueEl.className = 'cue';
      };
      still();
      new ResizeObserver(() => still()).observe(root);
      return;
    }

    // ───────── pointeur : glisser = orbite, clic ou geste rapide = swing ─────────
    let down: null | { id: number; x: number; y: number; t: number; moved: number; hist: { x: number; y: number; t: number }[] } = null;
    root.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('a, button, input, label, .intro, .panel')) return;
      if (introOpen) setIntro(false);   // un clic dans la scène referme l'encart et compte comme une action
      down = { id: e.pointerId, x: e.clientX, y: e.clientY, t: performance.now(), moved: 0, hist: [{ x: e.clientX, y: e.clientY, t: performance.now() }] };
      orbit.vaz = orbit.vel = 0;
      try { root.setPointerCapture(e.pointerId); } catch {}
    });
    root.addEventListener('pointermove', (e) => {
      if (!down || e.pointerId !== down.id) return;
      const last = down.hist[down.hist.length - 1], dx = e.clientX - last.x, dy = e.clientY - last.y;
      down.moved += Math.hypot(dx, dy);
      const now = performance.now();
      down.hist.push({ x: e.clientX, y: e.clientY, t: now }); while (down.hist.length > 2 && now - down.hist[0].t > 120) down.hist.shift();
      orbit.az -= dx * 0.006; orbit.el = Math.min(0.85, Math.max(-0.2, orbit.el + dy * 0.004));
    });
    const up = (e: PointerEvent) => {
      if (!down || e.pointerId !== down.id) return;
      const now = performance.now(), dur = now - down.t, h0 = down.hist[0], h1 = down.hist[down.hist.length - 1];
      const dt = Math.max(16, h1.t - h0.t), vx = (h1.x - h0.x) / dt, vy = (h1.y - h0.y) / dt, speed = Math.hypot(vx, vy);
      if (down.moved < 7 && dur < 450) swingNow();
      else if (dur < 320 && speed > FLICK_SPEED) { swingNow(); orbit.vaz = orbit.vel = 0; }
      else if (now - h1.t < 60) { orbit.vaz = -vx * 0.006 * 16; orbit.vel = vy * 0.004 * 16; }
      down = null;
    };
    root.addEventListener('pointerup', up);
    root.addEventListener('pointercancel', (e) => { if (down && e.pointerId === down.id) down = null; });
    addEventListener('keydown', (e) => {
      if (!visible || (e.code !== 'Space' && e.code !== 'Enter') || (e.target as HTMLElement)?.closest?.('a, button, input, textarea')) return;
      e.preventDefault(); swingNow();
    });

    // ───────── boucle ─────────
    let raf = 0, last = performance.now(), visible = true, lastSample = -1;
    const pad = (n: number, l = 2) => String(Math.floor(n)).padStart(l, '0');
    const loop = () => {
      raf = 0;
      if (!visible || document.hidden) return;
      const nowMs = performance.now(), now = nowMs / 1000, realDt = Math.max(0, Math.min((nowMs - last) / 1000, 0.05)); last = nowMs;
      // échelle de temps : ralenti pendant le swing et l'oscillation de la tige
      const inSwing = (st.mode === 'swing' || st.mode === 'follow') && simT - st.tS < st.span;
      const tsTarget = inSwing || st.mode === 'hold' ? slowTs : 1;
      timeScale += (tsTarget - timeScale) * (1 - Math.exp(-realDt * (tsTarget < timeScale ? 14 : 2.5)));
      acc += realDt * timeScale;
      let n = 0;
      while (acc >= H && n < 400) {
        step(); acc -= H; n++;
        if ((st.mode === 'swing' || st.mode === 'follow') && simT - st.tS <= st.span && simT - lastSample > st.span / 320) {
          samples.push({ t: simT, vM: st.vM, vT: st.vT, d: st.xM - st.xT }); lastSample = simT;
        }
      }
      if (n >= 400) acc = 0;
      if (!down) {
        const k = Math.pow(ORBIT_INERTIA, realDt * 60);
        orbit.az += orbit.vaz * realDt * 60 / 16; orbit.el = Math.min(0.85, Math.max(-0.2, orbit.el + orbit.vel * realDt * 60 / 16));
        orbit.vaz *= k; orbit.vel *= k;
      }
      // cadrage : après la frappe, la caméra suit un peu le volant
      const fs = now - impactReal;
      const fw = shPhase === 'out' || shPhase === 'landed' ? Math.min(1, fs / 0.6) * (1 - Math.min(1, Math.max(0, (fs - 4.5) / 1.2))) : 0;
      if (shPhase === 'out') { follow.want.copy(sh.p).sub(base); if (follow.want.length() > 4) follow.want.setLength(4); }
      follow.off.lerp(follow.want, 1 - Math.exp(-realDt * 6));
      follow.w += (fw - follow.w) * (1 - Math.exp(-realDt * 4));
      const dp = dustGeo.attributes.position.array as Float32Array;
      for (let i = 0; i < DUST; i++) { dp[i * 3 + 1] += Math.sin(now * 0.3 + dustSeed[i]) * 0.0004; dp[i * 3] += Math.cos(now * 0.2 + dustSeed[i]) * 0.0003; }
      dustGeo.attributes.position.needsUpdate = true;
      syncScene(now);
      render();
      drawScope();
      // repère d'action
      const sw = st.mode === 'swing' || st.mode === 'follow', s = simT - st.tS;
      if (st.mode === 'idle') setCue('idle', '', touch ? 'Touchez pour lancer un swing' : 'Cliquez pour lancer un swing', touch ? 'Tap to swing' : 'Click to swing');
      else if (st.mode === 'windup' || st.mode === 'hold') setCue('arm', 'calm', 'Armé…', 'Winding up…');
      else if (sw && !st.whip && s < 1.5 * cfg.tau) setCue('lag', 'hot', 'La tête prend du retard : la tige se courbe', 'The head lags: the shaft bends');
      else if (sw && s < 1.5 * cfg.tau) setCue('whip', 'hot', 'Effet fouet : la tête dépasse le manche', 'Whip: the head overtakes the handle');
      else if (sw) { const [ff, fe] = dec(st.p.w0 / (2 * Math.PI), 1); setCue('osc' + ff, 'calm', `La tige oscille à f₀ = ${ff} Hz puis s’amortit`, `The shaft rings at f₀ = ${fe} Hz, then settles`); }
      else setCue('rec', 'calm', 'Retour', 'Reset');
      slowRow?.classList.toggle('on', timeScale < 0.95);
      if (slowEl) slowEl.textContent = `×${(1 / Math.max(1e-3, timeScale)).toFixed(0)}`;
      if (tcEl) tcEl.textContent = `${pad(simT / 60)}:${pad(simT % 60)}:${pad((simT % 1) * 1000, 3)}`;
      raf = requestAnimationFrame(loop);
    };
    const start = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(loop); } };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) start(); }).observe(root);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
    new ResizeObserver(() => { resize(); drawGain(); }).observe(root);
    start();
  }
</script>

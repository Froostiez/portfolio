---
import { url } from '../utils';
const { overlay = false, bilingual = false } = Astro.props;
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/lab', label: 'Lab' },
  { href: '/photo', label: 'Photo' },
  { href: '/about', label: 'About' },
];
---
<header class:list={['nav', { overlay }]}>
  <a class="logo" href={url('/')}>Ferdinand<span>.</span></a>
  <nav class="links">
    {links.map((l) => <a href={url(l.href)}>{l.label}</a>)}
  </nav>
  {bilingual && (
    <button class="lang" type="button" aria-label="Changer de langue / Switch language">
      <span data-v="fr">FR</span><span class="sep">/</span><span data-v="en">EN</span>
    </button>
  )}
  <a class="pill glass contact" href={url('/contact')}>Contact</a>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav .lang');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.lang === 'en' ? 'fr' : 'en';
    root.dataset.lang = next;
    root.lang = next;
    try { localStorage.setItem('lang', next); } catch (e) {}
  });
</script>

<style>
  .nav {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 20px 28px; position: relative; z-index: 5;
  }
  .nav.overlay { position: absolute; inset: 0 0 auto 0; }
  :global(body:not(.has-hero)) .nav { position: fixed; inset: 0 0 auto 0; background: rgba(15,14,20,.7); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .logo { font-weight: 800; letter-spacing: -0.02em; text-decoration: none; font-size: 1.15rem; color: #fff; }
  .logo span { color: var(--pink); }
  .links { display: flex; gap: 28px; margin-right: auto; margin-left: 28px; }
  .links a { text-decoration: none; color: rgba(255,255,255,.85); font-size: .95rem; }
  .links a:hover { color: #fff; }
  .contact { padding: 8px 18px; }
  .lang {
    background: none; border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px;
    color: rgba(255,255,255,.5); font: inherit; font-size: .8rem; font-weight: 600; letter-spacing: .04em; cursor: pointer;
  }
  .lang:hover { border-color: rgba(255,255,255,.35); }
  .lang .sep { margin: 0 4px; opacity: .5; }
  :global(html:not([data-lang="en"])) .lang [data-v="fr"],
  :global(html[data-lang="en"]) .lang [data-v="en"] { color: #fff; }
  @media (max-width: 820px) { .links { display: none; } .nav { padding: 16px 18px; } .lang { margin-left: auto; } }
</style>

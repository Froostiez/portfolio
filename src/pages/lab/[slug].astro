---
import Base from '../../layouts/Base.astro';
import BrushReveal from '../../components/BrushReveal.astro';
import CrossField from '../../components/heroes/CrossField.astro';
import Bokeh from '../../components/heroes/Bokeh.astro';
import Meadow from '../../components/heroes/Meadow.astro';
import FlowField from '../../components/heroes/FlowField.astro';
import Petals from '../../components/heroes/Petals.astro';
import ForestReveal from '../../components/heroes/ForestReveal.astro';
import HeroCopy from '../../components/heroes/HeroCopy.astro';
import { experiments } from '../../content/experiments';
import { url } from '../../utils';

export function getStaticPaths() {
  return experiments.map((e) => ({ params: { slug: e.slug }, props: { experiment: e } }));
}

// Associe chaque slug à son composant.
const demos: Record<string, any> = {
  'brush-reveal': BrushReveal,
  'foret': ForestReveal,
  'champ-de-croix': CrossField,
  'mise-au-point': Bokeh,
  'prairie-au-vent': Meadow,
  'champ-de-flux': FlowField,
  'petales': Petals,
};

const { experiment } = Astro.props;
const Demo = demos[experiment.slug];
---
<Base title={`${experiment.title} · Lab`} hero>
  <Demo>
    <HeroCopy />
    <div class="lab-bar">
      <a class="pill glass" href={url('/lab')}>← Back to the lab</a>
      <span class="meta">{experiment.title}</span>
    </div>
  </Demo>
</Base>

<style>
  .lab-bar { position: absolute; right: 28px; bottom: 32px; display: flex; flex-direction: row-reverse; align-items: center; gap: 16px; color: #fff; }
  @media (max-width: 820px) { .lab-bar { right: auto; left: 18px; bottom: auto; top: 76px; flex-direction: row; } }
  .meta { color: rgba(255,255,255,.8); }
</style>

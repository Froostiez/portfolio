---
import Base from '../layouts/Base.astro';
import BrushReveal from '../components/BrushReveal.astro';
import { url } from '../utils';
---
<Base title="Ferdinand Lacroix · Portfolio & Lab" hero>
  <BrushReveal>
    <div class="bottom">
      <div class="left">
        <span class="eyebrow">Portfolio &amp; Lab</span>
        <h1>Code<br />Data<br />Curiosity</h1>
      </div>
      <div class="right">
        <a class="pill glass" href={url('/projects')}>Projects</a>
        <a class="pill solid" href={url('/lab')}>Open the lab</a>
      </div>
    </div>
  </BrushReveal>
</Base>

<style>
  .bottom { position: absolute; left: 0; right: 0; bottom: 0; padding: 0 28px 32px; display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .eyebrow {
    display: inline-block; padding: 6px 14px; border-radius: 999px; font-size: .8rem; letter-spacing: .06em; text-transform: uppercase;
    background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.25); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  h1 { margin: 14px 0 0; font-size: 3.8vw; line-height: .88; letter-spacing: -0.03em; font-weight: 800; text-transform: uppercase; }
  .right { display: flex; gap: 12px; }
  @media (max-width: 820px) {
    h1 { font-size: 9vw; }
    .bottom { flex-direction: column; align-items: flex-start; padding: 0 18px 24px; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { projects } from '../content/projects';
import { url } from '../utils';
---
<Base title="Projects · Ferdinand Lacroix">
  <main class="page">
    <h1>Projects</h1>
    <p class="lead">Une sélection de ce que j’ai construit.</p>
    <div class="grid">
      {projects.map((p) => {
        const Tag = p.link ? 'a' : 'div';
        return (
          <Tag class="card" href={p.link ? url(p.link) : undefined}>
            <div class="meta">{p.year}</div>
            <h3>{p.title}</h3>
            <p>{p.description}</p>
            <div class="tags">{p.stack.map((s) => <span class="tag">{s}</span>)}</div>
          </Tag>
        );
      })}
    </div>
  </main>
</Base>

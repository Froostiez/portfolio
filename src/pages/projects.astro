---
import Base from '../layouts/Base.astro';
import Coin from '../components/Coin.astro';
import { projects } from '../content/projects';
import { url } from '../utils';

const badge = { web: 'Web', android: 'Android', pro: 'Projet pro', lab: 'Lab' } as const;
const badgeEn = { web: 'Web', android: 'Android', pro: 'Pro project', lab: 'Lab' } as const;
const isExternal = (l?: string) => !!l && /^https?:/.test(l);
---
<Base title="Projects · Ferdinand Lacroix" bilingual>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Polices des sites des projets, réduites aux lettres des titres (paramètre text) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@900&family=Saira+Stencil+One&family=Press+Start+2P&family=DM+Sans:wght@700&text=MysteriaVEGAMONFIRE!Miette.&display=swap" />
  </Fragment>
  <main class="page">
    <h1>Projects</h1>
    <p class="lead" data-l="fr">Une sélection de ce que j’ai construit.</p>
    <p class="lead" data-l="en">A selection of things I’ve built.</p>
    <div class="grid">
      {projects.map((p) => {
        const Tag = p.link ? 'a' : 'div';
        const href = p.link ? (isExternal(p.link) ? p.link : url(p.link)) : undefined;
        return (
          <Tag class="card project" href={href} target={isExternal(p.link) ? '_blank' : undefined} rel={isExternal(p.link) ? 'noopener' : undefined}>
            {p.background && <div class="bg" style={`background-image:url(${url(p.background)})`} aria-hidden="true"></div>}
            {p.backgroundAlt && <div class="bg bg-alt" style={`background-image:url(${url(p.backgroundAlt)})`} aria-hidden="true"></div>}
      {p.cardBack && (
        <div class="cardback" aria-hidden="true" style={`--f1:${p.cardBack.fond};--p1:${p.cardBack.primaire};--o1:${p.cardBack.or};` + (p.cardBackAlt ? `--f2:${p.cardBackAlt.fond};--p2:${p.cardBackAlt.primaire};--o2:${p.cardBackAlt.or};` : '')}>
          <span>V</span>
        </div>
      )}
            {p.watermark && <img class="watermark" src={url(p.watermark)} alt="" loading="lazy" aria-hidden="true" />}
            <div class="top">
              {p.logo && p.logoBack ? (
                <Coin front={url(p.logo)} back={url(p.logoBack)} size={176} label={`Logo ${p.title}`} />
              ) : p.logo ? (
                <img class="logo" src={url(p.logo)} alt={`Logo ${p.title}`} width="72" height="72" loading="lazy" />
              ) : (
                <div class="logo placeholder" aria-hidden="true">{p.title[0]}</div>
              )}
              <span class="badge"><span data-l="fr">{badge[p.kind]}</span><span data-l="en">{badgeEn[p.kind]}</span></span>
            </div>
            <div class="meta">{p.year}</div>
            <h3 class:list={[p.titleStyle && `t-${p.titleStyle}`]}>{p.titleImage ? <img class="title-img" src={url(p.titleImage)} alt={p.title} height="22" /> : p.titleStyle === 'miette' ? <>{p.title}<span class="dot">.</span></> : p.title}</h3>
            <p data-l="fr">{p.description}</p>
            <p data-l="en">{p.descriptionEn}</p>
            <div class="tags">{p.stack.map((s) => <span class="tag">{s}</span>)}</div>
            {p.video && (
              <button class="demo" type="button"
                data-video={url(p.video)} data-video-fr={url(p.videoFr ?? p.video)}
                data-poster={p.videoPoster && url(p.videoPoster)} data-poster-fr={(p.videoPosterFr ?? p.videoPoster) && url((p.videoPosterFr ?? p.videoPoster)!)}
                aria-label={`Démo / demo: ${p.title}`}>
                {p.videoPoster && <img data-l="en" src={url(p.videoPoster)} alt="" loading="lazy" />}
                {(p.videoPosterFr ?? p.videoPoster) && <img data-l="fr" src={url((p.videoPosterFr ?? p.videoPoster)!)} alt="" loading="lazy" />}
                <span class="play" aria-hidden="true"></span>
                <span class="demo-label"><span data-l="fr">Voir la démo</span><span data-l="en">Watch the demo</span></span>
              </button>
            )}
            {p.link && <span class="go"><span data-l="fr">{p.linkLabel ?? 'Visiter'}</span><span data-l="en">{p.linkLabelEn ?? 'Visit'}</span> →</span>}
          </Tag>
        );
      })}
    </div>
  </main>
  <dialog class="player" aria-label="Démo vidéo">
    <button class="close" type="button" aria-label="Fermer">×</button>
    <video controls playsinline preload="none"></video>
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.player')!;
  const video = dialog.querySelector('video')!;
  const close = () => dialog.close();
  document.querySelectorAll<HTMLButtonElement>('.demo').forEach((b) =>
    b.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const fr = document.documentElement.dataset.lang !== 'en';
      video.poster = (fr ? b.dataset.posterFr : b.dataset.poster) ?? '';
      video.src = (fr ? b.dataset.videoFr : b.dataset.video)!;
      dialog.showModal();
      video.play().catch(() => {});
    })
  );
  dialog.querySelector('.close')!.addEventListener('click', close);
  dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });
  dialog.addEventListener('close', () => { video.pause(); video.removeAttribute('src'); video.load(); });
</script>

<style>
  .project { display: flex; flex-direction: column; position: relative; overflow: hidden; }
  .watermark { position: absolute; right: -46px; top: -46px; width: 210px; height: 210px; opacity: .16; pointer-events: none; transition: opacity .3s ease, transform .6s ease; }
  .project:hover .watermark { opacity: .3; transform: rotate(8deg); }
  .title-img { display: block; height: 1.4rem; width: auto; margin: .1rem 0; }
  .bg { position: absolute; inset: 0; background-size: 100% auto; background-position: center; background-repeat: repeat-y; opacity: .55; pointer-events: none; transition: opacity .5s ease; }
  .bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,12,.25), rgba(10,10,12,.75) 60%); }
  .cardback { --fond: var(--f1); --prim: var(--p1); --or: var(--o1); position: absolute; right: -34px; top: -38px; width: 150px; opacity: .55; pointer-events: none; aspect-ratio: 256 / 357; transform: rotate(12deg); border-radius: 10px; border: 2px solid var(--or); display: grid; place-items: center; transition: transform .5s ease;
    background: repeating-linear-gradient(45deg, color-mix(in srgb, var(--prim) 40%, transparent) 0 1.5px, transparent 1.5px 9px), repeating-linear-gradient(-45deg, color-mix(in srgb, var(--prim) 40%, transparent) 0 1.5px, transparent 1.5px 9px), var(--fond); }
  .cardback::before { content: ''; position: absolute; inset: 10px; border: 1px solid var(--or); border-radius: 2px; }
  .cardback::after { content: ''; position: absolute; width: 60px; height: 60px; background: var(--fond); border: 3px solid var(--or); transform: rotate(45deg); }
  .cardback span { position: relative; z-index: 1; font: bold 42px Georgia, 'Times New Roman', serif; color: var(--or); }
  .project:hover .cardback { opacity: .8; transform: rotate(6deg); --fond: var(--f2, var(--f1)); --prim: var(--p2, var(--p1)); --or: var(--o2, var(--o1)); }
  .bg-alt { opacity: 0; }
  .project:hover .bg-alt { opacity: .55; }
  .project:hover .bg:not(.bg-alt) { opacity: 0; }
  .project > :not(.watermark):not(.bg):not(.cardback) { position: relative; }
  .top { display: flex; align-items: center; justify-content: space-between; min-height: 176px; margin-bottom: 10px; }
  .logo { width: 72px; height: 72px; object-fit: contain; border-radius: 16px; }
  .placeholder { display: grid; place-items: center; background: var(--bg); border: 1px solid var(--line); font-size: 1.8rem; font-weight: 800; color: var(--accent); }
  .badge { align-self: flex-start; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; }
  .go { margin-top: auto; padding-top: 16px; font-size: .9rem; color: var(--accent); }
  .project .tags { margin-bottom: 0; }
  /* Titres dans la police de chaque projet */
  .t-vegamon { font-family: 'Saira Stencil One', Impact, 'Arial Narrow', sans-serif; font-weight: 400; font-size: 1.55rem; letter-spacing: .06em; text-transform: uppercase; color: #d4c4ff; line-height: 1.15; }
  .t-mysteria {
    font-family: 'Cinzel Decorative', Georgia, serif; font-weight: 900; font-size: 1.5rem; letter-spacing: .03em; line-height: 1.25;
    background: linear-gradient(120deg, #6fc3ff, #8f9dff 40%, #b48cff 70%, #e0b5ff); -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 0 10px rgba(140, 120, 255, .45)); width: fit-content;
  }
  .t-fire { font-family: 'Press Start 2P', system-ui, sans-serif; font-weight: 400; font-size: 1.05rem; letter-spacing: 1px; color: #ff4500; text-shadow: 3px 3px 0 #3b1200; line-height: 1.6; }
  .t-miette { font-family: 'DM Sans', system-ui, sans-serif; font-weight: 700; font-size: 1.45rem; letter-spacing: -0.03em; color: #f7efe6; }
  .t-miette .dot { color: #dc8468; }
  .demo {
    position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; margin-top: 16px; padding: 0;
    border: 1px solid var(--line); border-radius: 12px; overflow: hidden; cursor: pointer; background: var(--bg);
  }
  .demo img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .demo:hover img { transform: scale(1.04); }
  .demo .play {
    position: absolute; left: 50%; top: 50%; width: 52px; height: 52px; transform: translate(-50%, -50%);
    border-radius: 50%; background: rgba(15,14,20,.75); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    transition: transform .2s ease;
  }
  .demo .play::after { content: ''; position: absolute; left: 21px; top: 16px; border-style: solid; border-width: 10px 0 10px 16px; border-color: transparent transparent transparent #fff; }
  .demo:hover .play { transform: translate(-50%, -50%) scale(1.08); }
  .demo-label { position: absolute; left: 10px; bottom: 8px; font-size: .75rem; font-weight: 600; color: #fff; background: rgba(15,14,20,.7); padding: 2px 8px; border-radius: 999px; }
  .player { padding: 0; border: none; background: transparent; width: min(92vw, 1100px); max-width: none; overflow: visible; }
  .player::backdrop { background: rgba(5,5,8,.85); }
  .player video { display: block; width: 100%; aspect-ratio: 16 / 9; border-radius: 14px; background: #000; }
  .player .close {
    position: absolute; right: -6px; top: -44px; width: 36px; height: 36px; border-radius: 50%;
    border: 1px solid var(--line); background: var(--bg-2); color: #fff; font-size: 1.3rem; line-height: 1; cursor: pointer;
  }
</style>
